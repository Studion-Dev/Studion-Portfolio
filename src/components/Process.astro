---
import {
  MessageSquare,
  Layout,
  Code2,
  Rocket,
  ArrowUpRight,
  Sparkles,
} from '@lucide/astro';

const steps = [
  {
    number: '01',
    icon: MessageSquare,
    title: 'Diskusi & Kebutuhan',
    subtitle: 'Tahap Orientasi',
    description:
      'Diskusi santai via WhatsApp untuk menggali tujuan bisnis Anda, gaya desain yang disukai, serta fitur utama yang wajib ada di website.',
  },
  {
    number: '02',
    icon: Layout,
    title: 'Desain & Layout',
    subtitle: 'Visualisasi Brand',
    description:
      'Perancangan tata letak visual modern yang disesuaikan dengan identitas brand Anda. Mengutamakan kenyamanan pengunjung dan alur konversi.',
  },
  {
    number: '03',
    icon: Code2,
    title: 'Development & Coding',
    subtitle: 'Eksekusi Website',
    description:
      'Website mulai dibangun secara menyeluruh—mulai dari tampilan yang rapi di HP maupun komputer, hingga semua tombol dan formulir berfungsi dengan lancar.',
  },
  {
    number: '04',
    icon: Rocket,
    title: 'Uji Coba & Launching',
    subtitle: 'Siap Tayang',
    description:
      'Anda bisa mencoba langsung websitemu. Setelah semua detail dirapikan dan disesuaikan, website resmi dirilis dan siap digunakan untuk jualan.',
  },
];
---

<section
  id="process"
  class="relative w-full max-w-6xl mx-auto px-4 py-16 md:py-24 overflow-hidden"
>
  <!-- HEADER CENTERED -->
  <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16 md:mb-20">
    <div
      id="process-badge"
      class="inline-flex items-center gap-2 mb-3 bg-yellow-300 text-slate-950 font-bold text-xs px-3.5 py-1.5 rounded-full border border-yellow-400/50 shadow-sm opacity-0"
    >
      <Sparkles class="w-3.5 h-3.5 text-slate-950" />
      <span>HOW IT WORKS</span>
    </div>

    <h2
      id="process-headline"
      class="text-4xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight mb-4 opacity-0"
    >
      PROSES KERJA <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-800 to-blue-500">
        TERSTRUKTUR
      </span>
      <span class="text-yellow-400">.</span>
    </h2>

    <p
      id="process-body"
      class="text-slate-600 font-semibold text-base md:text-lg max-w-xl opacity-0"
    >
      Tanpa ribet. Empat langkah jelas untuk membawa ide bisnis Anda menjadi
      aset website berkinerja tinggi.
    </p>
  </div>

  <!-- ZIG-ZAG CARDS CONTAINER -->
  <div class="relative flex flex-col gap-4 lg:gap-2 max-w-5xl mx-auto">
    {steps.map((step, index) => {
      const isEven = index % 2 === 0; // Genap = Kiri | Ganjil = Kanan

      return (
        <div class="relative">
          <!-- GRID ROW (ZIG ZAG DESKTOP) -->
          <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
            <div
              class={`process-card lg:col-span-7 ${
                isEven ? 'lg:col-start-1' : 'lg:col-start-6'
              } opacity-0`}
              data-direction={isEven ? 'left' : 'right'}
            >
              <div class="group relative bg-white/80 backdrop-blur-sm border border-slate-200/80 rounded-3xl p-6 sm:p-8 hover:border-blue-500/50 hover:shadow-xl hover:shadow-blue-500/10 transition-all duration-300">
                <div class="flex items-start gap-4 sm:gap-5">
                  <!-- Number Badge -->
                  <div class="flex flex-col items-center gap-2 shrink-0">
                    <div class="w-12 h-12 rounded-2xl bg-slate-900 text-yellow-400 font-black text-lg font-heading flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 shadow-md">
                      {step.number}
                    </div>
                  </div>

                  <!-- Content -->
                  <div class="flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                      <h3 class="text-xl sm:text-2xl font-black text-slate-900 font-heading group-hover:text-blue-600 transition-colors">
                        {step.title}
                      </h3>
                      <span class="text-xs font-bold text-blue-600 bg-blue-50 px-3 py-1 rounded-full border border-blue-100">
                        {step.subtitle}
                      </span>
                    </div>

                    <p class="text-slate-600 text-sm sm:text-base font-medium leading-relaxed">
                      {step.description}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- CONNECTOR CIRKUIT ELEKTRONIK (DESKTOP) & STRAIGHT (MOBILE) -->
          {index < steps.length - 1 && (
            <div class="process-arrow relative w-full h-16 lg:h-20 my-1 opacity-0">
              {/* DESKTOP CIRCUIT PATH (Lurus -> Belok Rounded 90° -> Menunjuk Kartu Bawah) */}
              <div class="hidden lg:block w-full h-full">
                {isEven ? (
                  /* KARTU KIRI KE KARTU KANAN (Kiri -> Turun -> Belok Kanan ke Kartu 2) */
                  <svg
                    class="w-full h-full overflow-visible"
                    viewBox="0 0 1000 80"
                    fill="none"
                  >
                    <!-- Point Lingkaran Sumbu (Node) -->
                    <circle cx="200" cy="0" r="4" fill="#2563EB" />
                    <!-- Path Jalur Siku Rounded (r=16px) -->
                    <path
                      d="M 200 0 V 32 A 16 16 0 0 0 216 48 H 784 A 16 16 0 0 1 800 64 V 72"
                      stroke="#3B82F6"
                      stroke-width="2.5"
                      stroke-dasharray="6 6"
                      stroke-linecap="round"
                    />
                    <!-- Kepala Panah Menunjuk Kartu Kanan -->
                    <polygon points="795,70 800,80 805,70" fill="#2563EB" />
                  </svg>
                ) : (
                  /* KARTU KANAN KE KARTU KIRI (Kanan -> Turun -> Belok Kiri ke Kartu 3) */
                  <svg
                    class="w-full h-full overflow-visible"
                    viewBox="0 0 1000 80"
                    fill="none"
                  >
                    <!-- Point Lingkaran Sumbu (Node) -->
                    <circle cx="800" cy="0" r="4" fill="#2563EB" />
                    <!-- Path Jalur Siku Rounded (r=16px) -->
                    <path
                      d="M 800 0 V 32 A 16 16 0 0 1 784 48 H 216 A 16 16 0 0 0 200 64 V 72"
                      stroke="#3B82F6"
                      stroke-width="2.5"
                      stroke-dasharray="6 6"
                      stroke-linecap="round"
                    />
                    <!-- Kepala Panah Menunjuk Kartu Kiri -->
                    <polygon points="195,70 200,80 205,70" fill="#2563EB" />
                  </svg>
                )}
              </div>

              {/* MOBILE ONLY (Garis Putus-Putus Lurus ke Bawah) */}
              <div class="lg:hidden flex flex-col items-center justify-center h-full">
                <div class="h-10 w-0 border-r-2 border-dashed border-blue-500"></div>
                <div class="w-0 h-0 border-l-4 border-l-transparent border-r-4 border-r-transparent border-t-8 border-t-blue-600"></div>
              </div>
            </div>
          )}
        </div>
      );
    })}
  </div>

  <!-- BOTTOM CTA BUTTON -->
  <div id="process-cta" class="mt-14 flex justify-center opacity-0">
    <a
      href="https://wa.me/"
      target="_blank"
      rel="noopener noreferrer"
      class="group relative z-10 w-full md:w-auto inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-yellow-400 text-white hover:text-slate-950 font-bold text-sm px-6 py-3.5 rounded-2xl transition-all duration-200 shrink-0 shadow-lg"
    >
      <span>Mulai Konsultasi Sekarang</span>
      <ArrowUpRight class="w-4 h-4 text-yellow-400 group-hover:text-slate-950" />
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // 1. SET INITIAL STATES
    gsap.set('#process-badge', { y: -30, opacity: 0 });
    gsap.set(['#process-headline', '#process-body'], { y: 50, opacity: 0 });
    gsap.set('#process-cta', { y: 30, opacity: 0 });

    const processCards = document.querySelectorAll('.process-card');
    processCards.forEach((card) => {
      const dir = card.getAttribute('data-direction');
      const xOffset = dir === 'left' ? -100 : 100;
      gsap.set(card, { x: xOffset, opacity: 0, scale: 0.95 });
    });

    const arrows = document.querySelectorAll('.process-arrow');
    gsap.set(arrows, { opacity: 0, scaleY: 0, transformOrigin: 'top center' });

    ScrollTrigger.refresh();

    // 2. HEADER ANIMATION (RUN 1X)
    const headerTl = gsap.timeline({
      scrollTrigger: {
        trigger: '#process',
        start: 'top 65%',
        once: true,
      },
    });

    headerTl
      .to('#process-badge', {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: 'power2.out',
      })
      .to(
        '#process-headline',
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: 'back.out(1.4)',
        },
        '-=0.2'
      )
      .to(
        '#process-body',
        {
          opacity: 1,
          y: 0,
          duration: 0.5,
          ease: 'power2.out',
        },
        '-=0.3'
      );

    // 3. CARDS SLIDE KIRI/KANAN & SIRKUIT LINE ANIMATION (RUN 1X)
    processCards.forEach((card, index) => {
      gsap.to(card, {
        scrollTrigger: {
          trigger: card,
          start: 'top 70%',
          once: true,
        },
        x: 0,
        opacity: 1,
        scale: 1,
        duration: 0.8,
        ease: 'back.out(1.3)',
      });

      if (arrows[index]) {
        gsap.to(arrows[index], {
          scrollTrigger: {
            trigger: card,
            start: 'top 60%',
            once: true,
          },
          opacity: 1,
          scaleY: 1,
          duration: 0.6,
          delay: 0.15,
          ease: 'power2.out',
        });
      }
    });

    // 4. CTA BUTTON ANIMATION (RUN 1X)
    gsap.to('#process-cta', {
      scrollTrigger: {
        trigger: '#process-cta',
        start: 'top 85%',
        once: true,
      },
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power2.out',
    });
  });
</script>
