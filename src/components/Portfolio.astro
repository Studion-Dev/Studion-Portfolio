---
import { ArrowUpRight, Sparkles, Eye } from '@lucide/astro';

const featuredProject = {
  title: 'Medivoy',
  category: 'Klinik Kesehatan',
  problem: 'Reservasi Pasien Manual & Lambat',
  solution: 'Sistem Jadwal & Janji Temu Digital',
  description:
    'Transformasi platform digital klinik kesehatan dengan sistem reservasi antrean interaktif. Menghadirkan akses informasi dokter yang cepat dan meningkatkan kehadiran pasien secara signifikan.',
  image:
    'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=1200&q=80',
  slug: '/portfolio/medivoy',
};

const secondaryProjects = [
  {
    title: 'Rosenufa Florist',
    category: 'Florist',
    problem: 'Katalog Gambar Berantakan',
    solution: 'Katalog Visual Rapi & Terstruktur',
    description:
      'Menata etalase produk buket agar pelanggan dapat memilih jenis bunga berdasarkan acara dengan mudah.',
    image:
      'https://images.unsplash.com/photo-1561181286-d3fee7d55364?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/rosenufa-florist',
  },
  {
    title: 'Dearme Petals',
    category: 'Florist',
    problem: 'Terbatas di Format Linktree',
    solution: 'Website Brand Eksklusif',
    description:
      'Upgrade dari sekadar link bio sederhana menjadi website utuh yang meningkatkan citra brand buket bunga.',
    image:
      'https://images.unsplash.com/photo-1526047932273-341f2a7631f9?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/dearme-petals',
  },
  {
    title: 'Blooms and Craft',
    category: 'Florist',
    problem: 'Proses Order via Chat Lama',
    solution: 'Form Pemesanan Kustom Praktis',
    description:
      'Menyediakan alur pemesanan rangkaian bunga kustom yang langsung terarah tanpa tanya-jawab berbelit.',
    image:
      'https://images.unsplash.com/photo-1508610048659-a06b669e3321?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/blooms-and-craft',
  },
  {
    title: 'Crown Floral',
    category: 'Florist',
    problem: 'Tampilan Belum Kelihatan Trusted',
    solution: 'Desain Profil Bisnis Elegan',
    description:
      'Menampilkan katalog bunga papan dan hampers dengan estetik untuk meyakinkan klien korporat.',
    image:
      'https://images.unsplash.com/photo-1582794543139-8ac9cb0f7b11?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/crown-floral',
  },
  {
    title: 'Aura Fleur',
    category: 'Florist',
    problem: 'Situs Lama Kurang Aksesibel',
    solution: 'Website Mobile-Friendly Kencang',
    description:
      'Membangun ulang website agar nyaman diakses lewat smartphone tanpa loading yang membuang waktu.',
    image:
      'https://images.unsplash.com/photo-1533616688419-b7a585564566?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/aura-fleur',
  },
  {
    title: 'Nusa Selera Catering',
    category: 'Catering',
    problem: 'Pricelist Masih Bentuk PDF',
    solution: 'Menu Interaktif & Kalkulator Estimasi',
    description:
      'Memudahkan calon pengantin dan panitia event memilih paket makanan secara transparan langsung di web.',
    image:
      'https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/nusa-selera-catering',
  },
  {
    title: 'Kembara Nusantara',
    category: 'Travel Agency',
    problem: 'Info Paket Wisata Tercecer',
    solution: 'Bento Grid Itinerary Rapi',
    description:
      'Menyusun paket tur wisata secara terstruktur agar calon wisatawan siap melakukan reservasi.',
    image:
      'https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/kembara-nusantara',
  },
  {
    title: 'Explore Horison',
    category: 'Travel Agency',
    problem: 'Kurang Bukti Kepercayaan (Trust)',
    solution: 'Showcase Testimoni & Dokumen Resmi',
    description:
      'Menampilkan ulasan peserta open trip dan legalitas usaha untuk meyakinkan calon traveler baru.',
    image:
      'https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/explore-horison',
  },
  {
    title: 'Verve Event Planner',
    category: 'Event Organizer',
    problem: 'Portofolio Acara Tidak Tertata',
    solution: 'Galeri Dokumentasi Event Visual',
    description:
      'Menyajikan dokumentasi acara berskala besar agar calon brand partner mantap melakukan kerja sama.',
    image:
      'https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/verve-event-planner',
  },
  {
    title: 'Ruang Reka Studio',
    category: 'Interior Design',
    problem: 'Foto Hasil Proyek Lambat Memuat',
    solution: 'Galeri High-Res Super Ringan',
    description:
      'Memamerkan portofolio desain interior mewah dengan transisi halus tanpa memberatkan browser.',
    image:
      'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/ruang-reka-studio',
  },
];
---

<section
  id="portfolio"
  class="relative w-full max-w-6xl mx-auto px-4 py-16 md:py-24"
>
  <!-- SECTION HEADER -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 md:mb-16 gap-6 pb-8 border-b border-slate-200/80">
    <div class="flex flex-col items-start gap-3">
      <div class="inline-flex items-center gap-2 bg-yellow-300 text-slate-950 font-bold text-xs px-3.5 py-1.5 rounded-full border border-yellow-400/50 shadow-sm">
        <Sparkles class="w-3.5 h-3.5 text-slate-950" />
        <span>SELECTED WORKS</span>
      </div>
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight font-heading">
        KARYA{' '}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-blue-500">
          PILIHAN
        </span>
        <span class="text-yellow-400">.</span>
      </h2>
    </div>

    <p class="text-slate-600 font-semibold text-base md:text-lg max-w-md leading-relaxed">
      Kumpulan website yang dirancang khusus untuk mentransformasi kehadiran
      digital dan meningkatkan kepercayaan bisnis.
    </p>
  </div>

  <!-- FEATURED HERO SHOWCASE (MEDIVOY) -->
  <div class="mb-12">
    <div class="relative bg-slate-900 text-white rounded-3xl overflow-hidden shadow-2xl flex flex-col lg:grid lg:grid-cols-12 group">
      <!-- Top/Right Image Preview (Di Mobile Tampil Paling Atas) -->
      <div class="order-1 lg:order-2 lg:col-span-6 relative h-[240px] sm:h-[320px] lg:h-full w-full overflow-hidden bg-slate-800">
        <img
          src={featuredProject.image}
          alt={featuredProject.title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out opacity-90"
          loading="lazy"
        />
        <!-- Seamless Fade Gradient Effect: Bottom-to-Top di Mobile, Right-to-Left di Desktop -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent lg:bg-gradient-to-r lg:from-slate-900 lg:via-slate-900/30 lg:to-transparent"></div>
      </div>

      <!-- Bottom/Left Content Info (Di Mobile Tampil Di Bawah Gambar) -->
      <div class="order-2 lg:order-1 lg:col-span-6 p-6 sm:p-10 lg:p-12 flex flex-col justify-between z-10 -mt-6 sm:-mt-8 lg:mt-0 relative">
        <div>
          <!-- Category & Badge Feature Label -->
          <div class="flex items-center gap-2.5 mb-5 flex-wrap">
            <span class="bg-blue-600 text-white font-extrabold text-[11px] sm:text-xs uppercase px-3.5 py-1.5 rounded-full tracking-wider">
              {featuredProject.category}
            </span>
            <span class="bg-yellow-400 text-slate-950 font-black text-[10px] sm:text-[11px] uppercase px-3 py-1 rounded-full">
              Main Showcase Proyek
            </span>
          </div>

          <!-- Title -->
          <h3 class="text-3xl sm:text-5xl font-black font-heading mb-3 sm:mb-4 text-white group-hover:text-yellow-300 transition-colors">
            {featuredProject.title}
          </h3>

          <!-- Description -->
          <p class="text-slate-300 text-xs sm:text-base leading-relaxed mb-6">
            {featuredProject.description}
          </p>

          <!-- Problem & Solution Badges (Warna Seragam) -->
          <div class="space-y-2 mb-8">
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-300 bg-slate-800/80 px-3.5 py-2.5 rounded-xl border border-slate-700/80">
              <span class="text-slate-400 font-bold">Problem:</span>{' '}
              {featuredProject.problem}
            </div>
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-300 bg-slate-800/80 px-3.5 py-2.5 rounded-xl border border-slate-700/80">
              <span class="text-slate-400 font-bold">Solution:</span>{' '}
              {featuredProject.solution}
            </div>
          </div>
        </div>

        <!-- CTA Detail Button -->
        <div>
          <a
            href={featuredProject.slug}
            class="inline-flex items-center justify-center gap-2.5 bg-yellow-400 hover:bg-yellow-300 text-slate-950 font-black text-xs sm:text-sm px-6 py-3.5 rounded-2xl shadow-lg transition-all duration-300 w-full sm:w-auto"
          >
            <Eye class="w-4 h-4" />
            <span>Lihat Detail Proyek</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- SECONDARY PROJECTS GRID (10 CARDS) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {secondaryProjects.map((project) => (
      <div class="group bg-white border border-slate-200/80 rounded-3xl p-6 flex flex-col justify-between hover:border-blue-500/50 hover:shadow-xl transition-all duration-300">
        <div>
          <!-- Thumbnail Image -->
          <div class="relative overflow-hidden rounded-2xl bg-slate-100 border border-slate-200/80 mb-5 aspect-video">
            <span class="absolute top-3 left-3 z-10 bg-slate-900/80 backdrop-blur-md text-white text-[11px] font-bold px-3 py-1 rounded-full">
              {project.category}
            </span>
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
            />
          </div>

          <!-- Problem & Solution Badges (Warna Seragam) -->
          <div class="space-y-1.5 mb-4">
            <div class="text-[11px] font-medium text-slate-600 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200/60 truncate">
              <span class="font-bold text-slate-700">Problem:</span>{' '}
              {project.problem}
            </div>
            <div class="text-[11px] font-medium text-slate-600 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200/60 truncate">
              <span class="font-bold text-slate-700">Solution:</span>{' '}
              {project.solution}
            </div>
          </div>

          <!-- Title -->
          <h3 class="text-2xl font-black text-slate-900 mb-2 group-hover:text-blue-600 transition-colors font-heading">
            {project.title}
          </h3>

          <!-- Description -->
          <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed mb-6">
            {project.description}
          </p>
        </div>

        <!-- Single CTA: Lihat Detail -->
        <div class="pt-4 border-t border-slate-100">
          <a
            href={project.slug}
            class="inline-flex items-center justify-center gap-2 w-full border border-slate-300 hover:border-slate-800 hover:bg-slate-900 hover:text-white text-slate-800 font-bold text-xs sm:text-sm py-3 px-4 rounded-xl transition-all duration-300"
          >
            <span>Lihat Detail Proyek</span>
            <ArrowUpRight class="w-4 h-4 text-yellow-500" />
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- BOTTOM CTA SECTION -->
  <div class="mt-16 text-center">
    <a
      href="https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20saya%20tertarik%20membuat%20website%20seperti%20di%20portfolio"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm sm:text-base px-8 py-4 rounded-2xl shadow-lg shadow-blue-600/25 transition-all duration-300 group"
    >
      <span>Ingin Website Seperti Ini untuk Bisnis Anda?</span>
      <ArrowUpRight class="w-5 h-5 text-yellow-400 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
    </a>
  </div>
</section>
