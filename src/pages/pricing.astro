---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  Check,
  Sparkles,
  Zap,
  MessageCircle,
  ArrowRight,
  ShieldCheck,
  HelpCircle,
} from '@lucide/astro';

const pricingPlans = [
  {
    name: 'Starter Landing Page',
    badge: 'Cocok untuk Meta Ads',
    price: 'Rp 1.500.000',
    period: 'sekali bayar',
    desc: 'Solusi cepat dan kencang untuk kebutuhan kampanye promosi produk atau jasa tunggal.',
    isPopular: false,
    features: [
      '1 Halaman High Conversion',
      'Desain Modern & Custom Tailor-Made',
      'Ultra Fast Loading (Astro Tech)',
      'Integrasi WhatsApp Direct CTA',
      'Basic SEO & Open Graph Setup',
      'Meta Pixel & Analytics Ready',
      'Garansi Maintenance 1 Bulan',
    ],
    ctaText: 'Pilih Paket Starter',
    href: 'https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20saya%20tertarik%20dengan%20paket%20Starter%20Landing%20Page',
  },
  {
    name: 'Company Profile',
    badge: 'Paling Populer',
    price: 'Rp 3.200.000',
    period: 'sekali bayar',
    desc: 'Website profesional utuh untuk membangun kepercayaan dan kredibilitas brand bisnis Anda.',
    isPopular: true,
    features: [
      'Hingga 5-7 Halaman Kustom',
      'Desain Eksklusif (Non-Template)',
      'Setup Custom Domain .com / .id',
      'Fitur Katalog Produk / Layanan',
      'Integrasi Form Inquiry / Tiket',
      'Optimasi SEO On-Page Lengkap',
      'Mobile & Tablet Perfect Responsive',
      'Garansi Maintenance 3 Bulan',
    ],
    ctaText: 'Pilih Company Profile',
    href: 'https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20saya%20tertarik%20dengan%20paket%20Company%20Profile',
  },
  {
    name: 'Custom Web App',
    badge: 'Kebutuhan Kompleks',
    price: 'Rp 5.500.000+',
    period: 'mulai dari',
    desc: 'Untuk sistem web khusus dengan integrasi backend, basis data, atau dashboard admin.',
    isPopular: false,
    features: [
      'Arsitektur Tailor-Made Kompleks',
      'Integrasi Supabase / PostgreSQL Database',
      'Sistem Dynamic Content / CMS',
      'Custom API & Service Integration',
      'Optimasi Keamanan & High Scalability',
      'Prioritas Support & Training Admin',
      'Garansi Maintenance 6 Bulan',
    ],
    ctaText: 'Konsultasi Custom',
    href: 'https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20saya%20ingin%20diskusi%20proyek%20Custom%20Web%20App',
  },
];

const faqs = [
  {
    q: 'Apakah harga di atas sudah termasuk Domain dan Hosting?',
    a: 'Sudah. Semua paket sudah mencakup setup hosting kencang berstandar global dan bantuan konfigurasi custom domain pilihan Anda.',
  },
  {
    q: 'Berapa lama proses pengerjaan websitenya?',
    a: 'Untuk Landing Page rata-rata 3–5 hari kerja, Company Profile 7–12 hari kerja, sedangkan Custom Web App menyesuaikan kompleksitas fitur.',
  },
  {
    q: 'Bagaimana jika saya memiliki alokasi anggaran khusus?',
    a: 'Sangat fleksibel. Anda dapat mendiskusikannya langsung via WhatsApp untuk penyesuaian ruang lingkup fitur sesuai anggaran yang disiapkan.',
  },
];
---

<Layout title="Transparansi Biaya & Paket Website — Studion Web">
  <Navbar />

  <main class="pt-24 pb-20">
    <!-- HEADER PRICING -->
    <section class="max-w-4xl mx-auto px-4 text-center mb-16">
      <div class="inline-flex items-center gap-2 bg-yellow-300 text-slate-950 font-black text-xs uppercase px-4 py-1.5 rounded-full border border-yellow-400 mb-4">
        <Sparkles class="w-3.5 h-3.5" />
        <span>TRANSPARENT PRICING</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 font-heading tracking-tight leading-tight mb-4">
        Investasi Tepat Untuk <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-blue-500">
          Pertumbuhan Bisnis Anda.
        </span>
      </h1>

      <p class="text-slate-600 text-base sm:text-lg font-medium max-w-2xl mx-auto leading-relaxed">
        Tanpa biaya tersembunyi. Dapatkan website berkualitas tinggi, kencang,
        dan siap memberikan hasil nyata untuk bisnis Anda.
      </p>
    </section>

    <!-- PRICING CARDS GRID -->
    <section class="max-w-6xl mx-auto px-4 mb-20">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
        {pricingPlans.map((plan) => (
          <div
            class={`relative rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 ${
              plan.isPopular
                ? 'bg-slate-900 text-white shadow-2xl border-2 border-blue-500 scale-100 md:-translate-y-2'
                : 'bg-white/80 backdrop-blur-md text-slate-900 border border-slate-200/90 shadow-lg'
            }`}
          >
            {/* POPULAR BADGE */}
            {plan.isPopular && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-gradient-to-r from-blue-600 to-blue-400 text-white font-extrabold text-[11px] tracking-wider uppercase px-4 py-1 rounded-full shadow-md">
                {plan.badge}
              </div>
            )}

            <div>
              {/* Card Header */}
              <div class="flex items-center justify-between gap-2 mb-3">
                <h3
                  class={`text-xl font-bold font-heading ${plan.isPopular ? 'text-white' : 'text-slate-900'}`}
                >
                  {plan.name}
                </h3>
                {!plan.isPopular && (
                  <span class="text-[10px] font-bold text-slate-600 bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-200">
                    {plan.badge}
                  </span>
                )}
              </div>

              <p
                class={`text-xs font-medium leading-relaxed mb-6 ${plan.isPopular ? 'text-slate-300' : 'text-slate-600'}`}
              >
                {plan.desc}
              </p>

              {/* Price Tag */}
              <div class="mb-6 pb-6 border-b border-slate-200/60 dark:border-slate-800">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-1">
                  {plan.period}
                </span>
                <span
                  class={`text-3xl sm:text-4xl font-black font-heading ${plan.isPopular ? 'text-yellow-400' : 'text-slate-900'}`}
                >
                  {plan.price}
                </span>
              </div>

              {/* Features List */}
              <ul class="space-y-3 mb-8">
                {plan.features.map((feat) => (
                  <li class="flex items-start gap-3 text-xs sm:text-sm font-semibold">
                    <div
                      class={`p-0.5 rounded-full shrink-0 mt-0.5 ${plan.isPopular ? 'bg-blue-500/20 text-yellow-400' : 'bg-blue-50 text-blue-600'}`}
                    >
                      <Check class="w-3.5 h-3.5" />
                    </div>
                    <span
                      class={
                        plan.isPopular ? 'text-slate-200' : 'text-slate-700'
                      }
                    >
                      {feat}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            {/* CTA Button */}
            <a
              href={plan.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`w-full inline-flex items-center justify-center gap-2 font-bold text-sm py-4 rounded-2xl transition-all duration-300 group cursor-pointer ${
                plan.isPopular
                  ? 'bg-yellow-400 hover:bg-yellow-300 text-slate-950 shadow-lg shadow-yellow-400/20'
                  : 'bg-slate-900 hover:bg-blue-600 text-white shadow-md'
              }`}
            >
              <span>{plan.ctaText}</span>
              <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- CUSTOM BUDGET BANNER -->
    <section class="max-w-4xl mx-auto px-4 mb-20">
      <div class="bg-gradient-to-r from-blue-900 to-slate-900 text-white rounded-3xl p-8 sm:p-10 border border-slate-800 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
        <div>
          <div class="inline-flex items-center gap-1.5 text-yellow-400 font-bold text-xs uppercase mb-2">
            <Zap class="w-4 h-4 fill-yellow-400" />
            <span>Punya Alokasi Anggaran Spesifik?</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-black font-heading mb-2">
            Mari Diskusi & Sesuaikan Kebutuhan Anda
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm font-medium max-w-lg">
            Kami siap membantu menyesuaikan ruang lingkup fitur agar sesuai
            dengan anggaran yang Anda alokasikan.
          </p>
        </div>

        <a
          href="https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20saya%20ingin%20diskusi%20penawaran%20custom%20sesuai%20budget"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-flex items-center justify-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-slate-950 font-black text-sm px-6 py-3.5 rounded-xl shadow-lg transition-all"
        >
          <MessageCircle class="w-4 h-4 fill-slate-950" />
          <span>Chat Custom Quote</span>
        </a>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-black font-heading text-slate-900 mb-2">
          Pertanyaan Umum (FAQ)
        </h2>
        <p class="text-slate-600 text-sm font-medium">
          Informasi seputar proses pengerjaan dan ketentuan proyek.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs">
            <h4 class="text-base font-bold text-slate-900 font-heading mb-2 flex items-start gap-2">
              <HelpCircle class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
              <span>{faq.q}</span>
            </h4>
            <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed pl-7">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
