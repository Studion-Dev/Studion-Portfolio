---
import {
  MessageSquare,
  Layout,
  Code2,
  Rocket,
  ArrowUpRight,
  Sparkles,
} from '@lucide/astro';

const steps = [
  {
    number: '01',
    icon: MessageSquare,
    title: 'Diskusi & Kebutuhan',
    subtitle: 'Tahap Orientasi',
    description:
      'Diskusi santai via WhatsApp untuk menggali tujuan bisnis Anda, gaya desain yang disukai, serta fitur utama yang wajib ada di website.',
  },
  {
    number: '02',
    icon: Layout,
    title: 'Desain & Layout',
    subtitle: 'Visualisasi Brand',
    description:
      'Perancangan tata letak visual modern yang disesuaikan dengan identitas brand Anda. Mengutamakan kenyamanan pengunjung dan alur konversi.',
  },
  {
    number: '03',
    icon: Code2,
    title: 'Development & Coding',
    subtitle: 'Eksekusi Website',
    description:
      'Website mulai dibangun secara menyeluruh—mulai dari tampilan yang rapi di HP maupun komputer, hingga semua tombol dan formulir berfungsi dengan lancar.',
  },
  {
    number: '04',
    icon: Rocket,
    title: 'Uji Coba & Launching',
    subtitle: 'Siap Tayang',
    description:
      'Anda bisa mencoba langsung websitemu. Setelah semua detail dirapikan dan disesuaikan, website resmi dirilis dan siap digunakan untuk jualan.',
  },
];
---

<section
  id="process"
  class="relative w-full max-w-6xl mx-auto px-4 py-16 md:py-24"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">
    <!-- LEFT SIDE: Sticky Concept Header -->
    <div class="lg:col-span-5 lg:sticky lg:top-28 flex flex-col items-start">
      <div class="inline-flex items-center gap-2 mb-3 bg-yellow-300 text-slate-950 font-bold text-xs px-3.5 py-1.5 rounded-full border border-yellow-400/50 shadow-sm">
        <Sparkles class="w-3.5 h-3.5 text-slate-950" />
        <span>HOW IT WORKS</span>
      </div>

      <h2 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight font-heading leading-tight mb-6">
        PROSES KERJA <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-800 to-blue-500">
          TERSTRUKTUR
        </span>
        <span class="text-yellow-400">.</span>
      </h2>

      <p class="text-slate-600 font-semibold text-base md:text-lg leading-relaxed mb-8">
        Tanpa ribet. Empat langkah jelas untuk membawa ide bisnis Anda menjadi
        aset website berkinerja tinggi.
      </p>

      <a
        href="https://wa.me/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-slate-900 hover:bg-blue-600 text-white font-bold text-sm px-6 py-3.5 rounded-full shadow-lg hover:shadow-blue-600/30 transition-all duration-300 group"
      >
        <span>Mulai Konsultasi</span>
        <ArrowUpRight class="w-4 h-4 text-yellow-400 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
      </a>
    </div>

    <!-- RIGHT SIDE CONTAINER -->
    <div class="lg:col-span-7 relative">
      <!-- 1. MOBILE ONLY: HORIZONTAL SWIPE CAROUSEL (sm:hidden) -->
      <div class="block sm:hidden -mx-4 px-4">
        <div class="flex items-center justify-between text-xs font-bold text-slate-400 mb-3 px-1">
          <span>Geser untuk melihat alur →</span>
        </div>

        <div class="flex overflow-x-auto gap-4 snap-x snap-mandatory scrollbar-none pb-6">
          {steps.map((step) => (
            <div class="snap-center shrink-0 w-[85vw] max-w-[320px] bg-white border border-slate-200/90 rounded-3xl p-6 shadow-xl shadow-slate-200/50 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="w-12 h-12 rounded-2xl bg-slate-900 text-yellow-400 font-black text-lg font-heading flex items-center justify-center shadow-md">
                    {step.number}
                  </div>
                  <span class="text-[11px] font-bold text-blue-600 bg-blue-50 px-3 py-1 rounded-full border border-blue-100">
                    {step.subtitle}
                  </span>
                </div>

                <h3 class="text-xl font-black text-slate-900 font-heading mb-2">
                  {step.title}
                </h3>

                <p class="text-slate-600 text-xs font-medium leading-relaxed">
                  {step.description}
                </p>
              </div>

              <div class="pt-4 mt-6 border-t border-slate-100 flex items-center justify-between text-[11px] font-bold text-slate-400">
                <span>Langkah {step.number} dari 04</span>
                <span class="w-2 h-2 rounded-full bg-blue-600"></span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 2. DESKTOP / TABLET ONLY: VERTICAL TIMELINE (hidden sm:flex) -->
      <div class="hidden sm:flex flex-col gap-6 relative">
        <!-- Vertical Line Connector -->
        <div class="absolute left-8 top-8 bottom-8 w-1.5 bg-yellow-400/80 -z-10"></div>

        {steps.map((step) => (
          <div class="group relative bg-white/80 backdrop-blur-sm border border-slate-200/80 rounded-3xl p-6 sm:p-8 hover:border-blue-500/50 hover:shadow-xl hover:shadow-blue-500/10 transition-all duration-300">
            <div class="flex flex-col sm:flex-row items-start gap-5">
              <!-- Number Badge -->
              <div class="flex items-center gap-3 shrink-0">
                <div class="w-12 h-12 rounded-2xl bg-slate-900 text-yellow-400 font-black text-lg font-heading flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300 shadow-md">
                  {step.number}
                </div>
              </div>

              <!-- Content -->
              <div class="flex-1">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                  <h3 class="text-xl sm:text-2xl font-black text-slate-900 font-heading group-hover:text-blue-600 transition-colors">
                    {step.title}
                  </h3>
                  <span class="text-xs font-bold text-blue-600 bg-blue-50 px-3 py-1 rounded-full border border-blue-100">
                    {step.subtitle}
                  </span>
                </div>

                <p class="text-slate-600 text-sm sm:text-base font-medium leading-relaxed">
                  {step.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
