---
import { Send, Sparkles, ArrowUpRight } from '@lucide/astro';

const socialLinks = [
  {
    name: 'WhatsApp',
    handle: '+62 898-2177-722',
    desc: 'Respon cepat untuk diskusi proyek',
    href: 'https://wa.me/628982177722', // Ganti nomor WA Anda
    type: 'whatsapp',
    color: 'hover:border-emerald-500/50 hover:shadow-emerald-500/10',
    iconBg: 'bg-emerald-50 text-emerald-600 border-emerald-100',
  },
  {
    name: 'Instagram',
    handle: '@dion.site',
    desc: 'Cek update & portofolio terbaru',
    href: 'https://instagram.com/dion.site', // Ganti username IG Anda
    type: 'instagram',
    color: 'hover:border-pink-500/50 hover:shadow-pink-500/10',
    iconBg: 'bg-pink-50 text-pink-600 border-pink-100',
  },
  {
    name: 'Facebook',
    handle: 'Studion Web',
    desc: 'Komunitas & ulasan klien',
    href: 'https://facebook.com/share/19gvqjN5kq/',
    type: 'facebook',
    color: 'hover:border-blue-500/50 hover:shadow-blue-500/10',
    iconBg: 'bg-blue-50 text-blue-600 border-blue-100',
  },
];
---

<section
  id="contact"
  class="relative w-full max-w-6xl mx-auto px-4 py-16 md:py-24"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-start">
    <!-- LEFT COLUMN: Social CTA Wrappers & Info -->
    <div class="lg:col-span-5 flex flex-col items-start">
      <div class="inline-flex items-center gap-2 mb-3 bg-yellow-300 text-slate-950 font-bold text-xs px-3.5 py-1.5 rounded-full border border-yellow-400/50 shadow-sm">
        <Sparkles class="w-3.5 h-3.5 text-slate-950" />
        <span>START A PROJECT</span>
      </div>

      <h2 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight font-heading leading-tight mb-6">
        MARI BUAT <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-800 to-blue-500">
          WEBSITE IMPIAN
        </span>
        <span class="text-yellow-400">.</span>
      </h2>

      <p class="text-slate-600 font-semibold text-base sm:text-lg leading-relaxed mb-8">
        Punya pertanyaan atau ingin diskusi awal? Hubungi kami lewat platform
        favorit Anda atau isi form tiket proyek.
      </p>

      <!-- Social Media Wrapper Cards -->
      <div class="w-full flex flex-col gap-4">
        {socialLinks.map((item) => {
          return (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`group bg-white/80 backdrop-blur-sm border border-slate-200/80 rounded-2xl p-4 sm:p-5 flex items-center justify-between transition-all duration-300 shadow-sm ${item.color}`}
            >
              <div class="flex items-center gap-4">
                <div
                  class={`w-12 h-12 rounded-xl border flex items-center justify-center shrink-0 ${item.iconBg}`}
                >
                  {/* SVG WHATSAPP */}
                  {item.type === 'whatsapp' && (
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                    </svg>
                  )}

                  {/* SVG INSTAGRAM */}
                  {item.type === 'instagram' && (
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                  )}

                  {/* SVG FACEBOOK */}
                  {item.type === 'facebook' && (
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                    </svg>
                  )}
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="text-base font-bold text-slate-900 font-heading group-hover:text-blue-600 transition-colors">
                      {item.name}
                    </h3>
                  </div>
                  <p class="text-slate-500 text-xs font-medium mt-0.5">
                    {item.handle}
                  </p>
                </div>
              </div>

              <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 group-hover:bg-blue-600 group-hover:text-white transition-all shrink-0">
                <ArrowUpRight class="w-4 h-4" />
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- RIGHT COLUMN: Custom Project Ticket Form -->
    <div class="lg:col-span-7">
      <div class="bg-slate-900 text-white rounded-3xl p-6 sm:p-8 md:p-10 border border-slate-800 shadow-2xl relative overflow-hidden">
        <!-- Subtle Glow Background -->
        <div class="absolute -top-24 -right-24 w-72 h-72 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex items-center justify-between gap-4 mb-6 border-b border-slate-800 pb-5">
          <div>
            <span class="text-xs font-bold text-yellow-400 tracking-wider uppercase block mb-1">
              FAST-TRACK CONSULTATION
            </span>
            <h3 class="text-xl sm:text-2xl font-black font-heading text-white">
              Gratis Konsultasi Proyek Anda
            </h3>
          </div>
          <div class="w-10 h-10 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-yellow-400 shrink-0">
            <Sparkles class="w-5 h-5" />
          </div>
        </div>

        <!-- FORM INTERAKTIF TIKET -->
        <form id="project-ticket-form" class="space-y-5">
          <!-- Name & Business -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label
                for="client_name"
                class="block text-xs font-bold text-slate-300 uppercase mb-2"
              >
                Nama Anda *
              </label>
              <input
                type="text"
                id="client_name"
                required
                placeholder="misal: Dion Mantovani"
                class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-yellow-400 transition-colors"
              />
            </div>
            <div>
              <label
                for="business_name"
                class="block text-xs font-bold text-slate-300 uppercase mb-2"
              >
                Nama Bisnis / Brand *
              </label>
              <input
                type="text"
                id="business_name"
                required
                placeholder="misal: Kopi Kenangan"
                class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-yellow-400 transition-colors"
              />
            </div>
          </div>

          <!-- Service Type Selection -->
          <div>
            <label
              for="service_type"
              class="block text-xs font-bold text-slate-300 uppercase mb-2"
            >
              Kebutuhan Website *
            </label>
            <select
              id="service_type"
              required
              class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-yellow-400 transition-colors"
            >
              <option value="Website Landing Page">Website Landing Page</option>
              <option value="Website Company Profile">
                Website Company Profile
              </option>
              <option value="Website Katalog">Website Katalog</option>
              <option value="Redesign Website Lama">
                Redesign Website Lama
              </option>
            </select>
          </div>

          <!-- Budget Range Option -->
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase mb-2">
              Estimasi Budget Proyek
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="budget"
                  value="< 2 Juta"
                  class="peer hidden"
                  checked
                />
                <div class="border border-slate-700 bg-slate-800/50 rounded-xl p-2.5 text-center text-xs font-bold text-slate-300 peer-checked:border-yellow-400 peer-checked:bg-yellow-400/10 peer-checked:text-yellow-400 transition-all">
                  &lt; Rp 2 Juta
                </div>
              </label>
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="budget"
                  value="2 - 5 Juta"
                  class="peer hidden"
                />
                <div class="border border-slate-700 bg-slate-800/50 rounded-xl p-2.5 text-center text-xs font-bold text-slate-300 peer-checked:border-yellow-400 peer-checked:bg-yellow-400/10 peer-checked:text-yellow-400 transition-all">
                  Rp 2 - 5 Juta
                </div>
              </label>
              <label class="cursor-pointer col-span-2 sm:col-span-1">
                <input
                  type="radio"
                  name="budget"
                  value="> 5 Juta"
                  class="peer hidden"
                />
                <div class="border border-slate-700 bg-slate-800/50 rounded-xl p-2.5 text-center text-xs font-bold text-slate-300 peer-checked:border-yellow-400 peer-checked:bg-yellow-400/10 peer-checked:text-yellow-400 transition-all">
                  &gt; Rp 5 Juta
                </div>
              </label>
            </div>
          </div>

          <!-- Brief Notes -->
          <div>
            <label
              for="project_notes"
              class="block text-xs font-bold text-slate-300 uppercase mb-2"
            >
              Detail / Catatan Singkat (Opsional)
            </label>
            <textarea
              id="project_notes"
              rows="3"
              placeholder="Ceritakan singkat tujuan website atau fitur khusus yang Anda inginkan..."
              class="w-full bg-slate-800/80 border border-slate-700 rounded-xl p-4 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-yellow-400 transition-colors"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-yellow-400 text-white hover:text-slate-950 font-bold text-base py-4 rounded-xl shadow-lg transition-all duration-300 flex items-center justify-center gap-2 group cursor-pointer"
          >
            <Send class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
            <span>Kirim ke WhatsApp</span>
          </button>

          <p class="text-[11px] font-medium text-slate-400 text-center pt-1">
            ⚡ Pesan otomatis akan terformat rapi saat Anda terhubung ke
            WhatsApp kami.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- SCRIPT AUTO FORMAT WHATSAPP TICKET -->
<script>
  const form = document.getElementById(
    'project-ticket-form'
  ) as HTMLFormElement;
  const PHONE_NUMBER = '628982177722'; // Ganti dengan nomor WhatsApp utama Anda

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const name = (document.getElementById('client_name') as HTMLInputElement)
      .value;
    const business = (
      document.getElementById('business_name') as HTMLInputElement
    ).value;
    const service = (
      document.getElementById('service_type') as HTMLSelectElement
    ).value;
    const notes = (
      document.getElementById('project_notes') as HTMLTextAreaElement
    ).value;

    // Get Selected Budget
    const selectedBudget =
      (
        document.querySelector(
          'input[name="budget"]:checked'
        ) as HTMLInputElement
      )?.value || '-';

    // Format Message Text
    const text =
      `Halo Studion Web! Saya mau buat tiket diskusi proyek baru:\n\n` +
      `📌 *Detail Tiket Proyek*\n` +
      `• Nama: ${name}\n` +
      `• Brand / Bisnis: ${business}\n` +
      `• Jenis Website: ${service}\n` +
      `• Estimasi Budget: ${selectedBudget}\n` +
      `${notes ? `• Catatan: ${notes}\n` : ''}\n` +
      `Mohon diinfokan jadwal konsultasinya ya, terima kasih!`;

    const encodedText = encodeURIComponent(text);
    const whatsappUrl = `https://wa.me/${PHONE_NUMBER}?text=${encodedText}`;

    window.open(whatsappUrl, '_blank');
  });
</script>
