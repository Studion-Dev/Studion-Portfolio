---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  Check,
  Minus,
  Sparkles,
  MessageCircle,
  HelpCircle,
  Zap,
  ArrowRight,
} from '@lucide/astro';

// Daftar Fitur untuk Tabel Perbandingan
const comparisonFeatures = [
  {
    category: 'Spesifikasi Utama',
    items: [
      {
        name: 'Jumlah Halaman',
        starter: '1 Halaman (Landing)',
        company: '5 - 7 Halaman',
        custom: 'Unlimted / Kustom',
      },
      {
        name: 'Desain Custom (Non-Template)',
        starter: true,
        company: true,
        custom: true,
      },
      {
        name: 'Performa Ultra Fast Loading',
        starter: true,
        company: true,
        custom: true,
      },
      {
        name: 'Mobile & Tablet Responsive',
        starter: true,
        company: true,
        custom: true,
      },
    ],
  },
  {
    category: 'Fitur & Integrasi',
    items: [
      {
        name: 'Integrasi WhatsApp Direct CTA',
        starter: true,
        company: true,
        custom: true,
      },
      {
        name: 'Meta Pixel & Analytics Setup',
        starter: true,
        company: true,
        custom: true,
      },
      {
        name: 'Basic SEO & Open Graph Ready',
        starter: true,
        company: true,
        custom: true,
      },
      {
        name: 'Katalog Produk / Layanan',
        starter: false,
        company: true,
        custom: true,
      },
      {
        name: 'Form Inquiry / System Ticket',
        starter: false,
        company: true,
        custom: true,
      },
      {
        name: 'Integrasi Database (Supabase)',
        starter: false,
        company: false,
        custom: true,
      },
      {
        name: 'Dashboard Admin / CMS',
        starter: false,
        company: false,
        custom: true,
      },
      {
        name: 'Custom API Integration',
        starter: false,
        company: false,
        custom: true,
      },
    ],
  },
  {
    category: 'Layanan & Dukungan',
    items: [
      {
        name: 'Free Domain .com / .id (1 Thn)',
        starter: false,
        company: true,
        custom: true,
      },
      {
        name: 'Garansi Maintenance',
        starter: '1 Bulan',
        company: '3 Bulan',
        custom: '6 Bulan',
      },
      {
        name: 'Panduan Operasional Admin',
        starter: true,
        company: true,
        custom: true,
      },
      {
        name: 'Prioritas Technical Support',
        starter: false,
        company: false,
        custom: true,
      },
    ],
  },
];

const faqs = [
  {
    q: 'Apakah harga di atas sudah termasuk Domain dan Hosting?',
    a: 'Sudah. Untuk paket Company Profile dan Custom Web App sudah termasuk custom domain (.com/.id) serta setup hosting kencang berstandar global.',
  },
  {
    q: 'Berapa lama proses pengerjaan websitenya?',
    a: 'Untuk Starter Landing Page rata-rata 3–5 hari kerja, Company Profile 7–12 hari kerja, sedangkan Custom Web App menyesuaikan kompleksitas fitur.',
  },
  {
    q: 'Bagaimana jika saya memiliki alokasi anggaran khusus?',
    a: 'Sangat fleksibel. Anda dapat mendiskusikannya langsung via WhatsApp untuk penyesuaian ruang lingkup fitur sesuai anggaran yang disiapkan.',
  },
];
---

<Layout title="Tabel Perbandingan Paket & Harga — Studion Web">
  <Navbar />

  <main class="pt-24 pb-20">
    <!-- HEADER PRICING -->
    <section class="max-w-4xl mx-auto px-4 text-center mb-16">
      <div class="inline-flex items-center gap-2 bg-yellow-300 text-slate-950 font-black text-xs uppercase px-4 py-1.5 rounded-full border border-yellow-400 mb-4">
        <Sparkles class="w-3.5 h-3.5" />
        <span>TRANSPARENT COMPARISON</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 font-heading tracking-tight leading-tight mb-4">
        Bandingkan Fitur & <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-blue-500">
          Pilih Paket yang Sesuai.
        </span>
      </h1>

      <p class="text-slate-600 text-base sm:text-lg font-medium max-w-2xl mx-auto leading-relaxed">
        Pilih paket website yang paling tepat untuk mendukung akselerasi bisnis
        Anda secara transparan.
      </p>
    </section>

    <!-- CHECKLIST COMPARISON TABLE -->
    <section class="max-w-6xl mx-auto px-4 mb-20">
      <div class="overflow-x-auto rounded-3xl border border-slate-200 shadow-xl bg-white">
        <table class="w-full text-left border-collapse min-w-[700px]">
          {/* Table Header */}
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50/80">
              <th class="p-6 text-sm font-bold text-slate-500 uppercase tracking-wider w-2/5">
                Rincian Fitur
              </th>

              {/* Starter Column */}
              <th class="p-6 text-center w-1/5 border-l border-slate-200/60">
                <span class="block text-xs font-bold text-slate-500 uppercase">
                  Starter
                </span>
                <span class="block text-xl font-black text-slate-900 font-heading mt-1">
                  Rp 1.5M
                </span>
                <span class="block text-[11px] font-medium text-slate-500 mb-3">
                  Landing Page
                </span>
                <a
                  href="https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20saya%20tertarik%20dengan%20paket%20Starter"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center w-full bg-slate-900 hover:bg-blue-600 text-white font-bold text-xs py-2.5 px-3 rounded-xl transition-colors"
                >
                  Pilih Starter
                </a>
              </th>

              {/* Company Profile Column (Highlighted) */}
              <th class="p-6 text-center w-1/5 border-l border-r border-blue-500/30 bg-blue-50/50 relative">
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-blue-600 text-white text-[9px] font-extrabold uppercase px-3 py-0.5 rounded-full shadow-xs">
                  Populer
                </span>
                <span class="block text-xs font-bold text-blue-700 uppercase">
                  Company Profile
                </span>
                <span class="block text-xl font-black text-slate-900 font-heading mt-1">
                  Rp 3.2M
                </span>
                <span class="block text-[11px] font-medium text-slate-500 mb-3">
                  Website Utuh
                </span>
                <a
                  href="https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20saya%20tertarik%20dengan%20paket%20Company%20Profile"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center w-full bg-yellow-400 hover:bg-yellow-300 text-slate-950 font-black text-xs py-2.5 px-3 rounded-xl shadow-md transition-colors"
                >
                  Pilih Paket Ini
                </a>
              </th>

              {/* Custom Web App Column */}
              <th class="p-6 text-center w-1/5 border-l border-slate-200/60">
                <span class="block text-xs font-bold text-slate-500 uppercase">
                  Custom App
                </span>
                <span class="block text-xl font-black text-slate-900 font-heading mt-1">
                  Rp 5.5M+
                </span>
                <span class="block text-[11px] font-medium text-slate-500 mb-3">
                  Sistem Kompleks
                </span>
                <a
                  href="https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20saya%20ingin%20diskusi%20proyek%20Custom%20Web%20App"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center w-full bg-slate-900 hover:bg-blue-600 text-white font-bold text-xs py-2.5 px-3 rounded-xl transition-colors"
                >
                  Konsultasi
                </a>
              </th>
            </tr>
          </thead>

          {/* Table Body */}
          <tbody class="divide-y divide-slate-100 text-xs sm:text-sm font-medium">
            {comparisonFeatures.map((sec) => (
              <>
                {/* Category Header Row */}
                <tr class="bg-slate-100/70 border-y border-slate-200/80">
                  <td
                    colspan="4"
                    class="py-3 px-6 font-bold text-slate-900 font-heading text-xs tracking-wide uppercase"
                  >
                    {sec.category}
                  </td>
                </tr>

                {/* Feature Rows */}
                {sec.items.map((item) => (
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="py-4 px-6 font-semibold text-slate-800">
                      {item.name}
                    </td>

                    {/* Starter Value */}
                    <td class="py-4 px-6 text-center border-l border-slate-200/40">
                      {typeof item.starter === 'boolean' ? (
                        item.starter ? (
                          <Check class="w-5 h-5 text-blue-600 mx-auto" />
                        ) : (
                          <Minus class="w-4 h-4 text-slate-300 mx-auto" />
                        )
                      ) : (
                        <span class="font-bold text-slate-700">
                          {item.starter}
                        </span>
                      )}
                    </td>

                    {/* Company Profile Value */}
                    <td class="py-4 px-6 text-center border-l border-r border-blue-500/20 bg-blue-50/20">
                      {typeof item.company === 'boolean' ? (
                        item.company ? (
                          <Check class="w-5 h-5 text-blue-600 mx-auto" />
                        ) : (
                          <Minus class="w-4 h-4 text-slate-300 mx-auto" />
                        )
                      ) : (
                        <span class="font-bold text-blue-900">
                          {item.company}
                        </span>
                      )}
                    </td>

                    {/* Custom App Value */}
                    <td class="py-4 px-6 text-center border-l border-slate-200/40">
                      {typeof item.custom === 'boolean' ? (
                        item.custom ? (
                          <Check class="w-5 h-5 text-blue-600 mx-auto" />
                        ) : (
                          <Minus class="w-4 h-4 text-slate-300 mx-auto" />
                        )
                      ) : (
                        <span class="font-bold text-slate-700">
                          {item.custom}
                        </span>
                      )}
                    </td>
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- CUSTOM BUDGET BANNER -->
    <section class="max-w-4xl mx-auto px-4 mb-20">
      <div class="bg-gradient-to-r from-blue-900 to-slate-900 text-white rounded-3xl p-8 sm:p-10 border border-slate-800 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
        <div>
          <div class="inline-flex items-center gap-1.5 text-yellow-400 font-bold text-xs uppercase mb-2">
            <Zap class="w-4 h-4 fill-yellow-400" />
            <span>Punya Alokasi Anggaran Spesifik?</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-black font-heading mb-2">
            Mari Diskusi & Sesuaikan Kebutuhan Anda
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm font-medium max-w-lg">
            Kami siap membantu menyesuaikan ruang lingkup fitur agar sesuai
            dengan anggaran yang Anda alokasikan.
          </p>
        </div>

        <a
          href="https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20saya%20ingin%20diskusi%20penawaran%20custom%20sesuai%20budget"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-flex items-center justify-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-slate-950 font-black text-sm px-6 py-3.5 rounded-xl shadow-lg transition-all"
        >
          <MessageCircle class="w-4 h-4 fill-slate-950" />
          <span>Chat Custom Quote</span>
        </a>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-black font-heading text-slate-900 mb-2">
          Pertanyaan Umum (FAQ)
        </h2>
        <p class="text-slate-600 text-sm font-medium">
          Informasi seputar proses pengerjaan dan ketentuan proyek.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs">
            <h4 class="text-base font-bold text-slate-900 font-heading mb-2 flex items-start gap-2">
              <HelpCircle class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
              <span>{faq.q}</span>
            </h4>
            <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed pl-7">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
