---
import { Sparkles, Target, ShieldCheck } from '@lucide/astro';

const pillars = [
  {
    icon: Target,
    title: 'Fokus Konversi Bisnis',
    desc: 'Website dibentuk bukan cuma buat pajangan, tapi dirancang agar calon klien mudah menghubungi Anda.',
  },
  {
    icon: ShieldCheck,
    title: 'Transparan & Tanpa Hidden Fee',
    desc: 'Semua biaya dan kustomisasi dibahas tuntas di awal tanpa kejutan tagihan rahasia.',
  },
];
---

<section
  id="about"
  class="relative w-full max-w-6xl mx-auto px-4 py-16 md:py-24"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <!-- LEFT COLUMN: Narrative & Pillars -->
    <div class="lg:col-span-7 flex flex-col gap-8 order-2 lg:order-1">
      <!-- Main Text Card -->
      <div
        id="about-text-card"
        class="bg-white/80 backdrop-blur-md border border-slate-200/80 rounded-3xl p-6 sm:p-8 space-y-4 shadow-sm opacity-0"
      >
        <h3 class="text-xl sm:text-2xl font-black text-slate-900 font-heading">
          Aset Digital Terbaik Dimulai Dari Fondasi Yang Tepat.
        </h3>
        <p class="text-slate-600 font-medium text-sm sm:text-base leading-relaxed">
          Banyak UMKM dan brand independen kesulitan berkembang karena
          websitenya lambat, menggunakan template pasaran yang berat, atau alur
          transaksinya ribet.
        </p>
        <p class="text-slate-600 font-medium text-sm sm:text-base leading-relaxed">
          Di <strong class="text-slate-900 font-bold">STUDION WEB</strong>, kami
          menggabungkan estetika modern dengan performa kodingan tingkat tinggi
          agar bisnis Anda terlihat kredibel dan siap bersaing di pasar digital.
        </p>
      </div>

      <!-- Core Value Pillars -->
      <div id="about-pillars" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {pillars.map((item) => {
          const IconComp = item.icon;
          return (
            <div class="about-pillar-item bg-white/80 backdrop-blur-md border border-slate-200/80 rounded-2xl p-5 hover:border-blue-500/50 hover:shadow-md transition-all duration-300 opacity-0">
              <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 mb-3">
                <IconComp class="w-5 h-5" />
              </div>
              <h4 class="text-base font-bold text-slate-900 font-heading mb-1.5">
                {item.title}
              </h4>
              <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed">
                {item.desc}
              </p>
            </div>
          );
        })}
      </div>

      <!-- Small Callout -->
      <div id="about-callout" class="flex items-center gap-3 pt-2 opacity-0">
        <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse shrink-0"></div>
        <span class="text-xs sm:text-sm font-bold text-slate-700">
          Menerima project landing page & company profile baru bulan ini.
        </span>
      </div>
    </div>

    <!-- RIGHT COLUMN: Header & Brand Identity -->
    <div class="lg:col-span-5 flex flex-col items-start order-1 lg:order-2">
      <div
        id="about-badge"
        class="inline-flex items-center gap-2 text-blue-600 font-bold text-xs tracking-widest uppercase mb-4 opacity-0"
      >
        <span>ABOUT STUDION WEB</span>
      </div>

      <h2
        id="about-heading"
        class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight font-heading leading-tight mb-6 opacity-0"
      >
        SOLUSI SIMPEL <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-800 to-blue-500">
          UNTUK BISNIS ANDA
        </span>
        <span class="text-yellow-400">.</span>
      </h2>

      <p
        id="about-desc"
        class="text-slate-600 font-semibold text-base sm:text-lg leading-relaxed mb-8 opacity-0"
      >
        Kami hadir untuk memotong alur rumit pembuatan website. Pendekatan kami
        personal, langsung ke poin, dan berfokus penuh pada hasil akhir bisnis
        Anda.
      </p>

      <!-- Highlight Stat Box -->
      <div
        id="about-stat-box"
        class="w-full bg-slate-900 text-white rounded-3xl p-6 sm:p-7 border border-slate-800 shadow-xl relative overflow-hidden group opacity-0"
      >
        <div class="pointer-events-none absolute -inset-y-full w-1/2 -skew-x-12 bg-gradient-to-r from-transparent via-white/10 to-transparent transition-all duration-1000 ease-out -translate-x-full group-hover:translate-x-[400%]"></div>

        <div class="flex items-center justify-between gap-4 relative z-10">
          <div>
            <span class="text-3xl sm:text-4xl font-black font-heading text-yellow-400 block mb-1">
              100%
            </span>
            <span class="text-xs sm:text-sm font-bold text-slate-300">
              Tailor-Made & Performance Driven
            </span>
          </div>
          <div class="w-12 h-12 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-yellow-400 shrink-0">
            <Sparkles class="w-6 h-6" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // 1. SET INITIAL STATES PER ELEMEN
    gsap.set(['#about-badge', '#about-heading', '#about-desc'], {
      y: 35,
      opacity: 0,
    });
    gsap.set('#about-stat-box', { y: 40, opacity: 0, scale: 0.95 });
    gsap.set('#about-text-card', { y: 40, opacity: 0 });
    gsap.set('.about-pillar-item', { y: 30, opacity: 0 });
    gsap.set('#about-callout', { opacity: 0, y: 20 });

    ScrollTrigger.refresh();

    // 2. TRIGGER INDIVIDUAL UNTUK TIAP KOMPONEN SAAT MASUK VIEWPORT

    // A. Header Group (Badge, Heading, Desc)
    gsap.to(['#about-badge', '#about-heading', '#about-desc'], {
      opacity: 1,
      y: 0,
      duration: 0.6,
      stagger: 0.15,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#about-badge',
        start: 'top 85%',
        once: true,
      },
    });

    // B. Stat Box
    gsap.to('#about-stat-box', {
      opacity: 1,
      y: 0,
      scale: 1,
      duration: 0.6,
      ease: 'back.out(1.2)',
      scrollTrigger: {
        trigger: '#about-stat-box',
        start: 'top 85%',
        once: true,
      },
    });

    // C. Narrative Text Card
    gsap.to('#about-text-card', {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#about-text-card',
        start: 'top 85%',
        once: true,
      },
    });

    // D. Core Value Pillars (Stagger per item)
    gsap.to('.about-pillar-item', {
      opacity: 1,
      y: 0,
      duration: 0.5,
      stagger: 0.15,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#about-pillars',
        start: 'top 85%',
        once: true,
      },
    });

    // E. Callout Banner
    gsap.to('#about-callout', {
      opacity: 1,
      y: 0,
      duration: 0.5,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#about-callout',
        start: 'top 90%',
        once: true,
      },
    });
  });
</script>
