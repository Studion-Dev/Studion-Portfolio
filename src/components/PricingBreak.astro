---
import { Sparkles, ShieldCheck, ArrowRight } from '@lucide/astro';
---

<section id="pricing-break" class="w-full max-w-6xl mx-auto px-4 py-12">
  <!-- OUTER SHIMMER CONTAINER -->
  <div
    id="pb-card"
    class="relative rounded-3xl p-[1.5px] overflow-hidden opacity-0"
  >
    <!-- 1. SHIMMER LIGHT (Rotating Conic Gradient) -->
    <div
      id="pb-shimmer"
      class="absolute -inset-[150%] aspect-square m-auto bg-[conic-gradient(from_0deg,transparent_0_300deg,rgba(250,204,21,0.8)_330deg,rgba(59,130,246,0.9)_360deg)] pointer-events-none"
    ></div>

    <!-- 2. INNER MAIN CARD CONTENT -->
    <div class="relative bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white rounded-[23px] p-8 sm:p-12 shadow-2xl overflow-hidden z-10">
      <!-- Decorative Background Glow -->
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-yellow-400/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
        <!-- Text Info -->
        <div class="max-w-2xl text-center md:text-left">
          <div
            id="pb-badge"
            class="inline-flex items-center gap-2 bg-yellow-400/10 text-yellow-400 border border-yellow-400/20 text-xs font-bold px-3.5 py-1.5 rounded-full mb-4 opacity-0"
          >
            <Sparkles class="w-3.5 h-3.5" />
            <span>FLEXIBLE BUDGET & TRANSPARENT PRICING</span>
          </div>

          <h3
            id="pb-headline"
            class="text-2xl sm:text-3xl md:text-4xl font-black font-heading leading-tight mb-3 opacity-0"
          >
            Mau Tahu Estimasi Biaya & Penawaran Proyek Anda?
          </h3>

          <p
            id="pb-body"
            class="text-slate-300 text-sm sm:text-base font-medium leading-relaxed opacity-0"
          >
            Setiap bisnis punya kebutuhan beda. Chat langsung untuk diskusi{' '}
            <span class="text-yellow-400 font-semibold">
              scope fitur & budget
            </span>
            —tanpa biaya tersembunyi, transparan dari awal.
          </p>

          <div
            id="pb-trust"
            class="flex flex-wrap items-center justify-center md:justify-start gap-4 text-xs font-semibold text-slate-400 pt-4 opacity-0"
          >
            <span class="flex items-center gap-1.5">
              <ShieldCheck class="w-4 h-4 text-yellow-400" /> Bisa Disesuaikan
              Budget
            </span>
            <span class="flex items-center gap-1.5">
              <ShieldCheck class="w-4 h-4 text-yellow-400" /> Gratis Konsultasi
              Awal
            </span>
          </div>
        </div>

        <!-- CTA Button -->
        <div id="pb-cta" class="shrink-0 w-full md:w-auto opacity-0">
          <a
            href="https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20mau%20tanya%20estimasi%20harga%20dan%20penawaran%20website%20dong"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-yellow-400 hover:bg-yellow-300 text-slate-950 font-black text-base px-8 py-4 rounded-2xl shadow-xl hover:shadow-yellow-400/20 hover:-translate-y-0.5 transition-all duration-300 group cursor-pointer"
          >
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
            </svg>
            <span>Tanya Price List</span>
            <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // 1. SET INITIAL STATES FOR ENTRANCE
    gsap.set('#pb-card', { y: 40, opacity: 0, scale: 0.96 });
    gsap.set('#pb-badge', { y: -20, opacity: 0 });
    gsap.set(['#pb-headline', '#pb-body', '#pb-trust'], { y: 20, opacity: 0 });
    gsap.set('#pb-cta', { scale: 0.9, opacity: 0 });

    ScrollTrigger.refresh();

    // 2. ENTRANCE ANIMATION (VIEWPORT TRIGGER NAIK KE 85%)
    const pbTl = gsap.timeline({
      scrollTrigger: {
        trigger: '#pricing-break',
        start: 'top 85%', // Trigger ditaikkan agar animasi langsung jalan
        once: true,
      },
    });

    pbTl
      .to('#pb-card', {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.7,
        ease: 'back.out(1.2)',
      })
      .to(
        '#pb-badge',
        { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' },
        '-=0.3'
      )
      .to(
        '#pb-headline',
        { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' },
        '-=0.2'
      )
      .to(
        '#pb-body',
        { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' },
        '-=0.2'
      )
      .to(
        '#pb-trust',
        { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' },
        '-=0.2'
      )
      .to(
        '#pb-cta',
        { opacity: 1, scale: 1, duration: 0.5, ease: 'back.out(1.4)' },
        '-=0.3'
      );

    // 3. CONTINUOUS BORDER SHIMMER ANIMATION (LOOP 360 DEGREE)
    gsap.to('#pb-shimmer', {
      rotate: 360,
      duration: 6,
      repeat: -1,
      ease: 'linear',
    });
  });
</script>
