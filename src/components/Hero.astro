---
import { ArrowUpRight, Sparkles, CheckCircle2 } from '@lucide/astro';
---

<section
  id="hero"
  class="relative w-full max-w-5xl mx-auto px-4 pt-20 pb-16 text-center"
>
  <!-- Subtle Glowing Gradient Accent -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[500px] h-[250px] bg-gradient-to-tr from-blue-500/15 via-yellow-300/20 to-transparent blur-3xl rounded-full pointer-events-none -z-10"></div>

  <!-- Badge / Studio Label -->
  <div class="inline-flex items-center gap-2 bg-yellow-300 text-slate-950 font-black text-[11px] sm:text-xs tracking-wide uppercase px-4 py-1.5 rounded-full border border-yellow-400/60 shadow-sm mb-6">
    <Sparkles class="w-3.5 h-3.5 text-slate-950 shrink-0" />
    <span>STUDION WEB | AGENCY WEBSITE DEVELOPMENT</span>
  </div>

  <!-- Headline -->
  <h1 class="text-4xl sm:text-6xl md:text-7xl font-black text-slate-900 font-heading tracking-tight leading-[1.08] mb-6">
    Website Profesional. <br />
    <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-blue-600 to-blue-400">
      Kencang & Siap Online.
    </span>
  </h1>

  <!-- Subtitle Narasi dengan Highlight "Business Owner" -->
  <p class="text-slate-600 text-base sm:text-xl font-medium max-w-2xl mx-auto leading-relaxed mb-8">
    Membantu para{' '}
    <span class="relative inline-block font-bold text-slate-900">
      <span class="relative z-10 italic">Business Owner</span>
      <span class="absolute left-0 bottom-1 w-full h-2.5 bg-yellow-300/80 -rotate-1 -z-0 rounded-xs"></span>
    </span>{' '}
    memiliki website kustom yang super kencang, tampil elegan, dan dirancang
    khusus untuk meningkatkan kepercayaan calon pelanggan.
  </p>

  <!-- Dual CTA Buttons -->
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3.5 max-w-lg mx-auto mb-10">
    <!-- CTA Utama (WA) - Electric Blue & SVG WA -->
    <a
      href="https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20mau%20konsultasi%20proyek%20website"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2.5 bg-slate-800 hover:bg-slate-700 text-white font-bold text-base px-7 py-4 rounded-2xl shadow-lg shadow-blue-600/25 hover:shadow-blue-600/40 hover:-translate-y-0.5 transition-all duration-300 group cursor-pointer"
    >
      <!-- SVG WhatsApp -->
      <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
      </svg>
      <span>Konsultasi Gratis via WA</span>
      <ArrowUpRight class="w-5 h-5 text-yellow-400 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
    </a>

    <!-- CTA Sekunder (Portfolio) - Border Only -->
    <a
      href="#portfolio"
      class="inline-flex items-center justify-center gap-2 border border-slate-300 hover:border-slate-800 text-slate-800 font-bold text-base px-6 py-4 rounded-2xl transition-all duration-300"
    >
      <span>Lihat Portfolio</span>
    </a>
  </div>

  <!-- Micro Feature Badges -->
  <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-xs sm:text-sm font-bold text-slate-600">
    <span class="flex items-center gap-1.5 bg-white/80 border border-slate-200 px-3.5 py-1.5 rounded-xl shadow-xs">
      <CheckCircle2 class="w-4 h-4 text-blue-600" /> High Performance
    </span>
    <span class="flex items-center gap-1.5 bg-white/80 border border-slate-200 px-3.5 py-1.5 rounded-xl shadow-xs">
      <CheckCircle2 class="w-4 h-4 text-blue-600" /> Basic SEO Ready
    </span>
    <span class="flex items-center gap-1.5 bg-white/80 border border-slate-200 px-3.5 py-1.5 rounded-xl shadow-xs">
      <CheckCircle2 class="w-4 h-4 text-blue-600" /> Mobile Responsive
    </span>
  </div>
</section>
