---
import { ArrowUpRight, Sparkles, CheckCircle2, Zap } from '@lucide/astro';
---

<section
  id="hero"
  class="relative w-full max-w-6xl mx-auto px-4 pt-8 pb-12 md:pt-16 md:pb-20 overflow-hidden"
>
  <!-- Background Glow Multi-Aksen -->
  <div class="absolute top-12 left-1/2 -translate-x-1/2 w-[320px] sm:w-[550px] h-[250px] bg-gradient-to-tr from-blue-500/15 via-yellow-300/20 to-transparent blur-3xl rounded-full pointer-events-none -z-10"></div>

  <!-- 1. GIANT BRAND HEADLINE (DIATAS) -->
  <div class="w-full text-center mb-8 md:mb-12">
    <div class="inline-flex items-center gap-2 bg-yellow-300 text-slate-950 font-black text-[10px] sm:text-xs tracking-wider uppercase px-3.5 py-1.5 rounded-full border border-yellow-400/60 shadow-sm mb-4">
      <Sparkles class="w-3.5 h-3.5 text-slate-950 shrink-0" />
      <span>FREELANCE WEBSITE DEVELOPER</span>
    </div>

    <h1 class="text-[13vw] sm:text-[11vw] lg:text-[10vw] font-black text-slate-900 leading-[0.9] tracking-tight font-heading select-none">
      STUDION
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-blue-600 to-blue-400">
        WEB
      </span>
      <span class="text-yellow-400">.</span>
    </h1>
  </div>

  <!-- 2. MAIN CONTENT CARD WRAPPER (MOBILE-FRIENDLY GRID) -->
  <div class="bg-white/80 backdrop-blur-md border border-slate-200/90 rounded-3xl p-6 sm:p-8 md:p-10 shadow-xl shadow-slate-200/50">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Kiri: Value Statement & Features -->
      <div class="lg:col-span-7 flex flex-col items-start gap-5">
        <h2 class="text-slate-900 text-xl sm:text-2xl md:text-3xl font-extrabold leading-snug font-heading">
          Bantu{' '}
          <span class="text-blue-600 underline decoration-yellow-400 decoration-4 underline-offset-4">
            Business Owner
          </span>{' '}
          punya website eksklusif, super kencang, dan siap ngasilin leads.
        </h2>

        <p class="text-slate-600 text-sm sm:text-base font-medium leading-relaxed">
          Tanpa template pasaran yang berat. Dikoding kustom agar bisnis Anda
          terlihat jauh lebih kredibel dan tepercaya di mata calon customer.
        </p>

        <!-- Feature Badges -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 w-full pt-2">
          <div class="flex items-center gap-2 bg-slate-50 border border-slate-200/80 rounded-xl px-3 py-2 text-xs font-bold text-slate-700">
            <CheckCircle2 class="w-4 h-4 text-blue-600 shrink-0" />
            <span>High Performance</span>
          </div>
          <div class="flex items-center gap-2 bg-slate-50 border border-slate-200/80 rounded-xl px-3 py-2 text-xs font-bold text-slate-700">
            <CheckCircle2 class="w-4 h-4 text-blue-600 shrink-0" />
            <span>Basic SEO Ready</span>
          </div>
          <div class="flex items-center gap-2 bg-slate-50 border border-slate-200/80 rounded-xl px-3 py-2 text-xs font-bold text-slate-700">
            <CheckCircle2 class="w-4 h-4 text-blue-600 shrink-0" />
            <span>Custom Tailor-Made</span>
          </div>
        </div>
      </div>

      <!-- Kanan: CTA Box -->
      <div class="lg:col-span-5 flex flex-col items-stretch lg:items-end justify-center gap-3 pt-4 lg:pt-0 border-t lg:border-t-0 border-slate-100">
        <a
          href="https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20saya%20mau%20konsultasi%20proyek%20website"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-3 bg-slate-900 hover:bg-blue-600 text-white font-bold text-base px-6 py-4 rounded-2xl shadow-lg hover:shadow-blue-600/25 transition-all duration-300 group cursor-pointer"
        >
          <span>Mulai Konsultasi Proyek</span>
          <ArrowUpRight class="w-5 h-5 text-yellow-400 group-hover:text-white group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
        </a>

        <div class="flex items-center justify-center lg:justify-end gap-2 text-xs font-semibold text-slate-500">
          <Zap class="w-3.5 h-3.5 text-yellow-500 fill-yellow-500 shrink-0" />
          <span>Slot terbatas bulan ini — Fast response WA</span>
        </div>
      </div>
    </div>
  </div>
</section>
