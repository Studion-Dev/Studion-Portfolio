---
import { ArrowUp } from '@lucide/astro';

const navLinks = [
  { name: 'Portfolio', href: '#portfolio' },
  { name: 'Layanan', href: '#services' },
  { name: 'Proses', href: '#process' },
  { name: 'Tentang', href: '#about' },
  { name: 'Kontak', href: '#contact' },
];

const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-slate-950 text-white pt-16 pb-8 border-t border-slate-900 relative overflow-hidden">
  <!-- Subtle Background Glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-32 bg-blue-600/10 blur-[120px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 relative z-10">
    <!-- TOP ROW: Navigation & Back To Top -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 pb-12 border-b border-slate-800/80">
      <!-- Brand & Status Tag -->
      <div class="flex items-center gap-4">
        <span class="text-xl font-black tracking-tight font-heading text-white">
          STUDION<span class="text-blue-500">WEB</span>
          <span class="text-yellow-400">.</span>
        </span>
        <div class="h-4 w-[1px] bg-slate-800 hidden sm:block"></div>
        <div class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full text-emerald-400 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Available for New Projects
        </div>
      </div>

      <!-- Quick Nav Links -->
      <nav class="flex flex-wrap items-center justify-center gap-6 text-sm font-medium text-slate-400">
        {navLinks.map((link) => (
          <a href={link.href} class="hover:text-yellow-400 transition-colors">
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Back to Top Button -->
      <a
        href="#"
        class="w-10 h-10 rounded-xl bg-slate-900 border border-slate-800 hover:border-blue-500/50 flex items-center justify-center text-slate-400 hover:text-white transition-all group shrink-0"
        aria-label="Back to top"
      >
        <ArrowUp class="w-4 h-4 group-hover:-translate-y-0.5 transition-transform" />
      </a>
    </div>

    <!-- MIDDLE ROW: Giant Typography Statement -->
    <div class="py-12 text-center overflow-hidden select-none">
      <h2 class="text-[12vw] sm:text-[10vw] lg:text-[130px] font-black leading-none tracking-tighter uppercase font-heading text-transparent bg-clip-text bg-gradient-to-b from-slate-800 via-slate-900 to-slate-950 opacity-90">
        STUDION WEB
      </h2>
    </div>

    <!-- BOTTOM ROW: Copyright & Details -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-semibold text-slate-500 border-t border-slate-900 pt-8">
      <p>© {currentYear} Studion Web. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <span>Tailor-Made Web Development</span>
        <span>•</span>
        <span>Built with Astro & Tailwind</span>
      </div>
    </div>
  </div>
</footer>
