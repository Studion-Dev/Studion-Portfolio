---
import {
  Zap,
  Layout,
  Search,
  MessageSquare,
  ShieldCheck,
  ArrowUpRight,
} from '@lucide/astro';

const services = [
  {
    icon: Zap,
    title: 'Super Fast Loading',
    badge: 'Astro Architecture',
    description:
      'Dibangun dengan Astro JS untuk memastikan skor Google PageSpeed 90+, bikin pengunjung betah dan gak kabur karena loading lemot.',
    gridSpan: 'md:col-span-8',
    highlight: true,
  },
  {
    icon: Layout,
    title: 'Custom UI/UX Design',
    badge: 'Eksklusif',
    description:
      'Desain 100% tailor-made sesuai branding bisnis Anda. Tanpa template pasaran.',
    gridSpan: 'md:col-span-4',
    highlight: false,
  },
  {
    icon: Search,
    title: 'Basic SEO Optimized',
    badge: 'Google Ready',
    description:
      'Struktur HTML semantik, Meta Tags, Open Graph, dan Sitemap rapi agar website gampang ditemukan di Google.',
    gridSpan: 'md:col-span-4',
    highlight: false,
  },
  {
    icon: MessageSquare,
    title: 'High-Converting Direct WA',
    badge: 'Sales Ready',
    description:
      'Tombol Call-to-Action dan Form yang langsung terhubung ke WhatsApp bisnis untuk mempercepat transaksi calon klien.',
    gridSpan: 'md:col-span-8',
    highlight: true,
  },
];
---

<section
  id="services"
  class="relative w-full max-w-6xl mx-auto px-4 py-16 md:py-24"
>
  <!-- NEW CENTERED HEADER (No Border) -->
  <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-12 md:mb-16">
    <div class="inline-flex items-center gap-2 text-blue-600 font-bold text-xs tracking-widest uppercase mb-3">
      <span>OUR SERVICES</span>
    </div>

    <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight mb-4">
      VALUE & SOLUSI <br />
      <span class="inline-block bg-yellow-300 px-4 py-1 -rotate-1 rounded-2xl border border-yellow-400 text-slate-950">
        YANG ANDA DAPAT.
      </span>
    </h2>

    <p class="text-slate-600 font-semibold text-base md:text-lg max-w-xl">
      Bukan sekadar website cantik, tapi aset digital yang dirancang untuk
      performa tinggi dan konversi bisnis maksimal.
    </p>
  </div>

  <!-- BENTO GRID SERVICES -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
    {services.map((item) => {
      const IconComponent = item.icon;
      return (
        <div
          class={`group relative bg-white/70 backdrop-blur-sm border border-slate-200/80 rounded-3xl p-6 md:p-8 flex flex-col justify-between hover:border-blue-500/50 hover:shadow-2xl hover:shadow-blue-500/10 transition-all duration-300 ${item.gridSpan}`}
        >
          <!-- Top Badge & Icon -->
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
                <IconComponent class="w-6 h-6" />
              </div>
              <span class="text-xs font-bold text-slate-700 bg-slate-200/80 px-3 py-1.5 rounded-full border border-slate-300/50">
                {item.badge}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-2xl md:text-3xl font-black text-slate-900 mb-3 font-heading group-hover:text-blue-600 transition-colors">
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-slate-600 text-sm md:text-base font-medium leading-relaxed">
              {item.description}
            </p>
          </div>

          <!-- Bottom Visual Detail -->
          <div class="pt-6 mt-6 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
              <ShieldCheck class="w-4 h-4 text-blue-600" /> Guaranteed Quality
            </span>
            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 group-hover:bg-yellow-400 group-hover:text-slate-950 transition-all">
              <ArrowUpRight class="w-4 h-4" />
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- GUARANTEE BANNER WITH GLASS SHINE EFFECT -->
  <div class="group relative overflow-hidden mt-10 bg-slate-900 text-white rounded-3xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
    <!-- EFEK KILATAN KACA (SHINNER OVERLAY) -->
    <div class="pointer-events-none absolute -inset-y-full w-1/2 bg-gradient-to-r from-transparent via-white/15 to-transparent animate-shine"></div>

    <div class="flex items-center gap-4 relative z-10">
      <div class="w-12 h-12 rounded-full bg-yellow-400 text-slate-950 flex items-center justify-center shrink-0 font-bold text-xl font-heading shadow-md">
        ⚡
      </div>
      <div>
        <h4 class="text-lg md:text-xl font-bold font-heading">
          Butuh Fitur Custom / Integrasi Khusus?
        </h4>
        <p class="text-slate-300 text-sm font-medium">
          Bisa disesuaikan dengan alur bisnis & kebutuhan brand Anda.
        </p>
      </div>
    </div>

    <a
      href="https://wa.me/"
      target="_blank"
      rel="noopener noreferrer"
      class="relative z-10 w-full md:w-auto inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-yellow-400 text-white hover:text-slate-950 font-bold text-sm px-6 py-3.5 rounded-2xl transition-all duration-200 shrink-0 shadow-lg"
    >
      <span>Diskusi Kebutuhan Web</span>
      <ArrowUpRight class="w-4 h-4" />
    </a>
  </div>
</section>

<style>
  @keyframes shine {
    0% {
      transform: translateX(-150%) skewX(-12deg);
    }
    50%,
    100% {
      transform: translateX(350%) skewX(-12deg);
    }
  }

  .animate-shine {
    animation: shine 4s infinite ease-in-out;
  }
</style>
