---
import { Sparkles, Target, ShieldCheck, CheckCircle2 } from '@lucide/astro';

const pillars = [
  {
    icon: Target,
    title: 'Fokus Konversi Bisnis',
    desc: 'Website dibentuk bukan cuma buat pajangan, tapi dirancang agar calon klien mudah menghubungi Anda.',
  },
  {
    icon: ShieldCheck,
    title: 'Transparan & Tanpa Hidden Fee',
    desc: 'Semua biaya dan kustomisasi dibahas tuntas di awal tanpa kejutan tagihan rahasia.',
  },
];
---

<section
  id="about"
  class="relative w-full max-w-6xl mx-auto px-4 py-16 md:py-24"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <!-- LEFT COLUMN: Narrative & Pillars (Sekarang di Kiri) -->
    <div class="lg:col-span-7 flex flex-col gap-8 order-2 lg:order-1">
      <div class="bg-white/80 backdrop-blur-sm border border-slate-200/80 rounded-3xl p-6 sm:p-8 space-y-4 shadow-sm">
        <h3 class="text-xl sm:text-2xl font-black text-slate-900 font-heading">
          Aset Digital Terbaik Dimulai Dari Fondasi Yang Tepat.
        </h3>
        <p class="text-slate-600 font-medium text-sm sm:text-base leading-relaxed">
          Banyak UMKM dan brand independen kesulitan berkembang karena
          websitenya lambat, menggunakan template pasaran yang berat, atau alur
          transaksinya ribet.
        </p>
        <p class="text-slate-600 font-medium text-sm sm:text-base leading-relaxed">
          Di <strong class="text-slate-900 font-bold">STUDION WEB</strong>, kami
          menggabungkan estetika modern dengan performa kodingan tingkat tinggi
          agar bisnis Anda terlihat kredibel dan siap bersaing di pasar digital.
        </p>
      </div>

      <!-- Core Value Pillars -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {pillars.map((item) => {
          const IconComp = item.icon;
          return (
            <div class="bg-white/70 backdrop-blur-sm border border-slate-200/80 rounded-2xl p-5 hover:border-blue-500/50 transition-all duration-300">
              <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 mb-3">
                <IconComp class="w-5 h-5" />
              </div>
              <h4 class="text-base font-bold text-slate-900 font-heading mb-1.5">
                {item.title}
              </h4>
              <p class="text-slate-600 text-xs sm:text-sm font-medium leading-relaxed">
                {item.desc}
              </p>
            </div>
          );
        })}
      </div>

      <!-- Small Callout -->
      <div class="flex items-center gap-3 pt-2">
        <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse shrink-0"></div>
        <span class="text-xs sm:text-sm font-bold text-slate-700">
          Menerima project landing page & company profile baru bulan ini.
        </span>
      </div>
    </div>

    <!-- RIGHT COLUMN: Header & Brand Identity (Sekarang di Kanan) -->
    <div class="lg:col-span-5 flex flex-col items-start order-1 lg:order-2">
      <div class="inline-flex items-center gap-2 text-blue-600 font-bold text-xs tracking-widest uppercase mb-4">
        <span>ABOUT STUDION WEB</span>
      </div>

      <h2 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight font-heading leading-tight mb-6">
        SOLUSI SIMPEL <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-800 to-blue-500">
          UNTUK BISNIS ANDA
        </span>
        <span class="text-yellow-400">.</span>
      </h2>

      <p class="text-slate-600 font-semibold text-base sm:text-lg leading-relaxed mb-8">
        Kami hadir untuk memotong alur rumit pembuatan website. Pendekatan kami
        personal, langsung ke poin, dan berfokus penuh pada hasil akhir bisnis
        Anda.
      </p>

      <!-- Highlight Stat Box -->
      <div class="w-full bg-slate-900 text-white rounded-3xl p-6 sm:p-7 border border-slate-800 shadow-xl relative overflow-hidden group">
        <div class="pointer-events-none absolute -inset-y-full w-1/2 -skew-x-12 bg-gradient-to-r from-transparent via-white/10 to-transparent transition-all duration-1000 ease-out -translate-x-full group-hover:translate-x-[400%]"></div>

        <div class="flex items-center justify-between gap-4">
          <div>
            <span class="text-3xl sm:text-4xl font-black font-heading text-yellow-400 block mb-1">
              100%
            </span>
            <span class="text-xs sm:text-sm font-bold text-slate-300">
              Tailor-Made & Performance Driven
            </span>
          </div>
          <div class="w-12 h-12 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-yellow-400 shrink-0">
            <Sparkles class="w-6 h-6" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
