---
import { ArrowUpRight, Sparkles, Eye } from '@lucide/astro';

const projects = [
  {
    id: 'medivoy',
    title: 'Medivoy',
    category: 'Klinik Kesehatan',
    problem: 'Reservasi Pasien Manual & Lambat',
    solution: 'Sistem Jadwal & Janji Temu Digital',
    description:
      'Transformasi platform digital klinik kesehatan dengan sistem reservasi antrean interaktif. Menghadirkan akses informasi dokter yang cepat dan meningkatkan kehadiran pasien secara signifikan.',
    image:
      'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=1200&q=80',
    slug: '/portfolio/medivoy',
  },
  {
    id: 'rosenufa-florist',
    title: 'Rosenufa Florist',
    category: 'Florist',
    problem: 'Katalog Gambar Berantakan',
    solution: 'Katalog Visual Rapi & Terstruktur',
    description:
      'Menata etalase produk buket agar pelanggan dapat memilih jenis bunga berdasarkan acara dengan mudah.',
    image:
      'https://images.unsplash.com/photo-1561181286-d3fee7d55364?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/rosenufa-florist',
  },
  {
    id: 'dearme-petals',
    title: 'Dearme Petals',
    category: 'Florist',
    problem: 'Terbatas di Format Linktree',
    solution: 'Website Brand Eksklusif',
    description:
      'Upgrade dari sekadar link bio sederhana menjadi website utuh yang meningkatkan citra brand buket bunga.',
    image:
      'https://images.unsplash.com/photo-1526047932273-341f2a7631f9?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/dearme-petals',
  },
  {
    id: 'kembara-nusantara',
    title: 'Kembara Nusantara',
    category: 'Travel Agency',
    problem: 'Info Paket Wisata Tercecer',
    solution: 'Bento Grid Itinerary Rapi',
    description:
      'Menyusun paket tur wisata secara terstruktur agar calon wisatawan siap melakukan reservasi.',
    image:
      'https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/kembara-nusantara',
  },
  {
    id: 'ruang-reka-studio',
    title: 'Ruang Reka Studio',
    category: 'Interior Design',
    problem: 'Foto Hasil Proyek Lambat Memuat',
    solution: 'Galeri High-Res Super Ringan',
    description:
      'Memamerkan portofolio desain interior mewah dengan transisi halus tanpa memberatkan browser.',
    image:
      'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80',
    slug: '/portfolio/ruang-reka-studio',
  },
];
---

<section
  id="portfolio"
  class="relative w-full max-w-6xl mx-auto px-4 py-16 md:py-24"
>
  <!-- SECTION HEADER -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 md:mb-16 gap-6 pb-8">
    <div class="flex flex-col items-start gap-3">
      <!-- Badge Badge Entrance -->
      <div
        id="portfolio-badge"
        class="inline-flex items-center gap-2 bg-yellow-300 text-slate-950 font-bold text-xs px-3.5 py-1.5 rounded-full border border-yellow-400/50 shadow-xs opacity-0"
      >
        <Sparkles class="w-3.5 h-3.5 text-slate-950" />
        <span>SELECTED WORKS</span>
      </div>
      <!-- Headline Entrance -->
      <h2
        id="portfolio-headline"
        class="text-4xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight font-heading opacity-0"
      >
        KARYA{' '}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-blue-500">
          PILIHAN
        </span>
        <span class="text-yellow-400">.</span>
      </h2>
    </div>

    <!-- Body Text Entrance -->
    <p
      id="portfolio-body"
      class="text-slate-600 font-medium text-base md:text-lg max-w-md leading-relaxed opacity-0"
    >
      Kumpulan website yang dirancang khusus untuk mentransformasi kehadiran
      digital dan meningkatkan kepercayaan bisnis.
    </p>
  </div>

  <!-- INTERACTIVE SCROLL SHOWCASE CONTAINER -->
  <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- LEFT PANEL: STICKY SLIDING INFO CARD (DESKTOP) -->
    <div
      id="left-sticky-panel"
      class="hidden lg:block lg:col-span-5 lg:sticky lg:top-28 z-20 opacity-0"
    >
      <div class="bg-slate-900 text-white p-7 sm:p-9 rounded-3xl shadow-xl border border-slate-800 relative overflow-hidden">
        <!-- Glow Effect Accent -->
        <div class="absolute -top-12 -right-12 w-40 h-40 bg-blue-600/20 rounded-full blur-2xl pointer-events-none"></div>

        <!-- MASK CONTAINER (Overflow Hidden untuk Potong Slide Teks) -->
        <div class="relative overflow-hidden min-h-[380px] flex flex-col justify-between">
          <div id="project-info-container" class="relative z-10 w-full">
            <!-- Category Badge -->
            <div class="flex items-center gap-2.5 mb-4">
              <span
                id="info-category"
                class="bg-blue-600 text-white font-bold text-xs uppercase px-3.5 py-1 rounded-full"
              >
                {projects[0].category}
              </span>
            </div>

            <!-- Title -->
            <h3
              id="info-title"
              class="text-3xl sm:text-4xl font-black font-heading text-white mb-4"
            >
              {projects[0].title}
            </h3>

            <!-- Description -->
            <p
              id="info-description"
              class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6 min-h-[72px]"
            >
              {projects[0].description}
            </p>

            <!-- Problem & Solution -->
            <div class="space-y-2.5 mb-8">
              <div class="flex items-start gap-2 text-xs sm:text-sm font-medium text-slate-300 bg-slate-800/90 p-3 rounded-xl border border-slate-700/60">
                <span class="text-yellow-400 font-bold shrink-0">Problem:</span>
                <span id="info-problem">{projects[0].problem}</span>
              </div>
              <div class="flex items-start gap-2 text-xs sm:text-sm font-medium text-slate-300 bg-slate-800/90 p-3 rounded-xl border border-slate-700/60">
                <span class="text-blue-400 font-bold shrink-0">Solution:</span>
                <span id="info-solution">{projects[0].solution}</span>
              </div>
            </div>

            <!-- CTA Dynamic Link -->
            <a
              id="info-link"
              href={projects[0].slug}
              class="inline-flex items-center justify-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-slate-950 font-black text-sm px-6 py-3.5 rounded-xl shadow-md transition-all duration-300 w-full"
            >
              <Eye class="w-4 h-4" />
              <span>Lihat Detail Proyek</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT PANEL: SCROLLABLE THUMBNAILS LIST -->
    <div class="lg:col-span-7 space-y-12 sm:space-y-16">
      {projects.map((project, index) => (
        <div
          class="project-card group relative bg-white border border-slate-200/80 rounded-3xl p-4 sm:p-5 shadow-sm hover:shadow-xl transition-all duration-500 opacity-0"
          data-index={index}
          data-title={project.title}
          data-category={project.category}
          data-description={project.description}
          data-problem={project.problem}
          data-solution={project.solution}
          data-slug={project.slug}
        >
          <!-- Image Box -->
          <div class="relative aspect-[16/10] w-full overflow-hidden rounded-2xl bg-slate-100">
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-slate-950/10 group-hover:bg-transparent transition-colors duration-300"></div>
          </div>

          <!-- Mobile Only Text Details -->
          <div class="mt-4 lg:hidden space-y-3 p-2">
            <span class="inline-block bg-blue-100 text-blue-700 text-xs font-bold px-3 py-1 rounded-full">
              {project.category}
            </span>
            <h4 class="text-2xl font-black text-slate-900 font-heading">
              {project.title}
            </h4>
            <p class="text-slate-600 text-xs sm:text-sm">
              {project.description}
            </p>
            <a
              href={project.slug}
              class="inline-flex items-center justify-center gap-2 w-full border border-slate-300 text-slate-800 font-bold text-xs py-3 rounded-xl hover:bg-slate-900 hover:text-white transition-all"
            >
              <span>Lihat Detail Proyek</span>
              <ArrowUpRight class="w-4 h-4 text-yellow-500" />
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- BOTTOM CTA -->
  <div id="portfolio-cta" class="mt-20 text-center opacity-0">
    <a
      href="https://wa.me/"
      target="_blank"
      rel="noopener noreferrer"
      class="relative group z-10 w-full md:w-auto inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-yellow-400 text-white hover:text-slate-950 font-bold text-sm px-6 py-3.5 rounded-2xl transition-all duration-200 shrink-0 shadow-lg"
    >
      <span>Ingin Website Seperti Ini Untuk Bisnis Anda?</span>
      <ArrowUpRight class="w-4 h-4 text-yellow-400 group-hover:text-slate-950" />
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // 1. ANIMASI MASUK HEADER & BODY TEXT
    const headerTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: '#portfolio',
        start: 'top 80%',
      },
    });

    headerTimeline
      .to('#portfolio-badge', {
        opacity: 1,
        scale: 1,
        duration: 0.4,
        ease: 'back.out(1.5)',
      })
      .to(
        '#portfolio-headline',
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: 'back.out(1.2)',
        },
        '-=0.2'
      )
      .to(
        '#portfolio-body',
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: 'power2.out',
        },
        '-=0.4'
      )
      .to(
        '#left-sticky-panel',
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power2.out',
        },
        '-=0.3'
      )
      .to(
        '#portfolio-cta',
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: 'power2.out',
        },
        '-=0.3'
      );

    // Initial state offset untuk header elements
    gsap.set('#portfolio-badge', { scale: 0.8 });
    gsap.set(
      [
        '#portfolio-headline',
        '#portfolio-body',
        '#left-sticky-panel',
        '#portfolio-cta',
      ],
      { y: 30 }
    );

    // 2. ANIMASI MASUK KARTU KANAN (FADE + BOUNCE SIKIT)
    const cards = document.querySelectorAll('.project-card');

    cards.forEach((card) => {
      gsap.set(card, { y: 50, opacity: 0, scale: 0.96 });

      gsap.to(card, {
        scrollTrigger: {
          trigger: card,
          start: 'top 85%',
          toggleActions: 'play none none reverse',
        },
        y: 0,
        opacity: 1,
        scale: 1,
        duration: 0.7,
        ease: 'back.out(1.2)', // Bounce kenyal halus pas mendarat
      });
    });

    // 3. INTERACTIVE SLIDING TEXT UNTUK PANEL KIRI (DESKTOP ONLY)
    const mm = gsap.matchMedia();

    mm.add('(min-width: 1024px)', () => {
      const infoContainer = document.getElementById('project-info-container');
      const categoryEl = document.getElementById('info-category');
      const titleEl = document.getElementById('info-title');
      const descEl = document.getElementById('info-description');
      const problemEl = document.getElementById('info-problem');
      const solutionEl = document.getElementById('info-solution');
      const linkEl = document.getElementById('info-link') as HTMLAnchorElement;

      let currentIndex = 0;
      let isAnimating = false;

      cards.forEach((card, index) => {
        ScrollTrigger.create({
          trigger: card,
          start: 'top 55%',
          end: 'bottom 45%',
          onEnter: () => animateSlide(index, 'down'),
          onEnterBack: () => animateSlide(index, 'up'),
        });
      });

      function animateSlide(targetIndex: number, direction: 'down' | 'up') {
        if (currentIndex === targetIndex || isAnimating || !infoContainer)
          return;
        isAnimating = true;

        const activeCard = cards[targetIndex] as HTMLElement;
        const data = activeCard.dataset;

        const exitY = direction === 'down' ? -40 : 40;
        const enterY = direction === 'down' ? 40 : -40;

        const tl = gsap.timeline({
          onComplete: () => {
            currentIndex = targetIndex;
            isAnimating = false;
          },
        });

        tl.to(infoContainer, {
          y: exitY,
          opacity: 0,
          duration: 0.25,
          ease: 'power2.in',
          onComplete: () => {
            if (categoryEl) categoryEl.textContent = data.category || '';
            if (titleEl) titleEl.textContent = data.title || '';
            if (descEl) descEl.textContent = data.description || '';
            if (problemEl) problemEl.textContent = data.problem || '';
            if (solutionEl) solutionEl.textContent = data.solution || '';
            if (linkEl && data.slug) linkEl.href = data.slug;

            gsap.set(infoContainer, { y: enterY, opacity: 0 });
          },
        }).to(infoContainer, {
          y: 0,
          opacity: 1,
          duration: 0.35,
          ease: 'back.out(1.2)',
        });
      }
    });
  });
</script>
