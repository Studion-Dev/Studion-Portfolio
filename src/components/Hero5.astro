---
import {
  ArrowUpRight,
  Sparkles,
  CheckCircle2,
  MessageCircle,
} from '@lucide/astro';
---

<section
  id="hero"
  class="relative w-full max-w-6xl mx-auto px-4 pt-12 pb-16 md:pt-20 md:pb-24 text-center"
>
  <!-- Subtle Glowing Gradient Accent -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[500px] h-[250px] bg-gradient-to-tr from-blue-500/15 via-yellow-300/20 to-transparent blur-3xl rounded-full pointer-events-none -z-10"></div>

  <!-- Badge / Studio Label -->
  <div class="inline-flex items-center gap-2 bg-yellow-300 text-slate-950 font-black text-[11px] sm:text-xs tracking-wide uppercase px-4 py-1.5 rounded-full border border-yellow-400/60 shadow-sm mb-6">
    <Sparkles class="w-3.5 h-3.5 text-slate-950 shrink-0" />
    <span>FREELANCE WEBSITE DEVELOPER</span>
  </div>

  <!-- Headline Raksasa: STUDION WEB. -->
  <h1 class="text-5xl sm:text-7xl md:text-[140px] font-black text-slate-900 font-heading tracking-tight leading-none select-none mb-6">
    STUDION{' '}
    <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-blue-600 to-blue-400">
      WEB
    </span>
    <span class="text-yellow-400">.</span>
  </h1>

  <!-- Subtitle Narasi -->
  <p class="text-slate-600 text-base sm:text-xl font-medium max-w-2xl mx-auto leading-relaxed mb-8">
    Bantu bisnis Anda punya website eksklusif, super kencang, dan siap konversi
    tanpa template pasaran yang berat.
  </p>

  <!-- Dual CTA Buttons -->
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3.5 max-w-md mx-auto mb-10">
    <!-- CTA Utama (WA) -->
    <a
      href="https://wa.me/628XXXXXXXXX?text=Halo%20Studion%20Web,%20mau%20konsultasi%20proyek%20website"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2.5 bg-slate-900 hover:bg-blue-600 text-white font-bold text-base px-8 py-4 rounded-2xl shadow-xl hover:shadow-blue-600/25 transition-all duration-300 group cursor-pointer"
    >
      <MessageCircle class="w-5 h-5 text-yellow-400 fill-yellow-400" />
      <span>Konsultasi via WA</span>
      <ArrowUpRight class="w-5 h-5 text-yellow-400 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
    </a>

    <!-- CTA Sekunder (Portfolio) -->
    <a
      href="#portfolio"
      class="inline-flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200/80 text-slate-800 font-bold text-base px-6 py-4 rounded-2xl transition-colors"
    >
      <span>Lihat Portfolio</span>
    </a>
  </div>

  <!-- Micro Feature Badges -->
  <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-xs sm:text-sm font-bold text-slate-600">
    <span class="flex items-center gap-1.5 bg-white/80 border border-slate-200 px-3.5 py-1.5 rounded-xl shadow-xs">
      <CheckCircle2 class="w-4 h-4 text-blue-600" /> High Speed
    </span>
    <span class="flex items-center gap-1.5 bg-white/80 border border-slate-200 px-3.5 py-1.5 rounded-xl shadow-xs">
      <CheckCircle2 class="w-4 h-4 text-blue-600" /> Basic SEO Ready
    </span>
    <span class="flex items-center gap-1.5 bg-white/80 border border-slate-200 px-3.5 py-1.5 rounded-xl shadow-xs">
      <CheckCircle2 class="w-4 h-4 text-blue-600" /> No Hidden Fee
    </span>
  </div>
</section>
